# Dependencies
node_modules/
.pnpm-store/
/.pnp
.pnp.*

# Build outputs
.next/
.next-e2e/
# Any alternate NEXT_DIST_DIR build (e.g. .next-c65), never tracked.
.next-*/
dist/
build/
out/
*.tsbuildinfo

# Next.js generated types (per Next.js docs: must not be tracked)
next-env.d.ts

# Vercel
.vercel

# Turborepo
.turbo/

# Prisma generated client (regenerated by @repo/db#generate)
packages/db/src/generated/

# Env
.env
.env.local
.env.*.local
!.env.example

# Testing
coverage/
playwright-report/
test-results/
blob-report/

# Editors / OS
.DS_Store
Thumbs.db
*.pem
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Misc local state — do not commit generated credentials or local DB files
*.sqlite
*.sqlite3
*.db

# Uploaded media (ADR-017) — local-disk storage driver root, git-ignored
storage/

# Playwright
apps/web/e2e/.auth/
apps/web/test-results/
apps/web/playwright-report/
