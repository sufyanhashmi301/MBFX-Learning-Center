// packages/db/prisma/schema.prisma
//
// MariaDB schema — MBX Learning Center
// Covers: auth, RBAC, employees, settings, theming, i18n, navigation, content.
// Ported from docs/reference/schema.prisma with the A4/A5.4 review fixes
// (plan.md) and the auth-table shape locked by ADR-001.
//
// Conventions
//   - Every table has createdAt / updatedAt.
//   - Anything user-visible and text-based is translated via a *Translation table.
//   - Slugs live on translation rows, never on base rows (per-locale URLs).
//   - Soft delete via deletedAt only where recovery matters (content, users).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────────────────────────
// IDENTITY & AUTH
//
// User/Account/Session/Verification/TwoFactor below are the shape
// `better-auth generate` (better-auth 1.7.2) produces for this project's
// plugin set (admin, two-factor, bearer), merged with project fields as
// Better Auth `additionalFields` — validated end-to-end against this exact
// MariaDB target in the ADR-001 spike (sign-up, argon2id hash, session
// persistence + revocation, Redis-backed rate limiting). Hand-ported here
// rather than re-run through the CLI because `packages/auth` (Module 04)
// doesn't exist yet and Module 01's auth tables are only gated on the
// *decision*, not on Module 04 shipping first. Module 04 owns regenerating
// this block if the auth config changes; see ADR-001 for the CLI's known
// `issuer` generation bug this schema already works around.
// ─────────────────────────────────────────────────────────────

enum UserType {
  LEARNER
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

model User {
  // ─── Better Auth core (generated) ───
  id            String   @id
  name          String   @db.Text
  email         String
  emailVerified Boolean  @default(false)
  image         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // admin plugin
  role       String?   @db.Text
  banned     Boolean?  @default(false)
  banReason  String?   @db.Text
  banExpires DateTime?

  // two-factor plugin (supersedes the plan's original mfaEnabled/mfaSecret —
  // the plugin brings its own fields + the TwoFactor table below)
  twoFactorEnabled Boolean? @default(false)

  // ─── Project fields (additionalFields, ADR-001) ───
  // firstName/lastName/phone are ours; Better Auth's own name/image stay in
  // sync at the app layer (Module 04/10 own that reconciliation).
  firstName        String?    @db.VarChar(100)
  lastName         String?    @db.VarChar(100)
  phone            String?    @db.VarChar(32)
  // ADR-155 — the learner's own birthday and postal address. Deliberately NOT
  // Better Auth additionalFields: the library never reads them, so they never
  // enter the session cookie cache and `/update-user` cannot write them.
  birthDate        DateTime?  @db.Date
  addressLine1     String?    @db.VarChar(200)
  addressLine2     String?    @db.VarChar(200)
  city             String?    @db.VarChar(100)
  region           String?    @db.VarChar(100)
  postalCode       String?    @db.VarChar(20)
  /// ISO 3166-1 alpha-2. The name is `Intl.DisplayNames`' job, in the reader's locale.
  country          String?    @db.VarChar(2)
  userType         UserType   @default(LEARNER)
  status           UserStatus @default(PENDING_VERIFICATION)
  locale           String     @default("en") @db.VarChar(10)
  timezone         String     @default("UTC") @db.VarChar(64)
  themeMode        ThemeMode  @default(SYSTEM)
  lastLoginAt      DateTime?
  lastLoginIp      String?    @db.VarChar(45)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  deletedAt        DateTime?

  accounts       Account[]
  sessions       Session[]
  twofactors     TwoFactor[]
  roles          UserRole[]
  permissions    UserPermission[]
  employee       Employee?
  auditLogs      AuditLog[]
  notifications  Notification[]
  // ADR-019, design-only — see Comment.
  comments       Comment[]
  // ADR-056 — learner progress. All three cascade on user delete (GDPR-shaped).
  lessonProgress LessonProgress[]
  enrollments    CourseEnrollment[]
  lessonFeedback LessonFeedback[]
  quizAttempts   QuizAttempt[]
  // ADR-080 #6 — the ONE relation here that does NOT cascade. Newsletter
  // consent is given independently of the account, so a hard erase nulls the
  // link and keeps the subscription (`onDelete: SetNull` on the other side).
  subscriptions  NewsletterSubscriber[]
  // ADR-097 — the AI meter. `SetNull` on the other side for the same reason
  // the newsletter link is: a deleted staff account must not delete the spend
  // record it caused, and spend history outlives the person who spent it.
  aiUsage        AiUsage[]
  // ADR-123 — the profile page's "recent reading". Cascades like progress:
  // it is a learner's own activity, not a record anyone else needs kept.
  articleReads   ArticleRead[]

  @@unique([email])
  @@index([userType, status])
  @@index([deletedAt])
  @@map("user")
}

// OAuth + credential provider links (Better Auth generated).
model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  // Required core field as of Better Auth 1.7 ("account identity is scoped
  // by issuer") — omitted by `better-auth generate` v1.7.2's Prisma output;
  // added by hand per ADR-001 finding #2. Re-verify after any better-auth bump.
  issuer                String    @db.VarChar(255)
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Not part of Better Auth's own generated output, but it's exactly the key
  // its internal adapter queries by (findAccountByKey/findAccountOwnerByKey)
  // — enforcing it at the DB level closes a gap the app layer already
  // assumes is closed.
  @@unique([issuer, accountId(length: 191)])
  @@index([userId])
  @@map("account")
}

// Database-backed sessions so revocation is immediate (security.md #11).
// `session.storeSessionInDatabase: true` is mandatory in Module 04's auth
// config — ADR-001 finding #1: Better Auth defaults to Redis-only session
// storage once `secondaryStorage` is configured, which this project's
// security rules don't allow.
model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?  @db.Text
  userAgent      String?  @db.Text
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?  @db.Text

  @@unique([token])
  @@index([userId])
  @@map("session")
}

// Email verification / password reset / invitation tokens. Identifier-keyed,
// not user-FK'd — matches Better Auth's own design (a token can outlive the
// context of a specific user row, e.g. email-change verification).
model Verification {
  id         String   @id
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}

// two-factor plugin (Better Auth generated).
model TwoFactor {
  id                      String    @id
  secret                  String    @db.Text
  backupCodes             String    @db.Text
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret(length: 191)])
  @@index([userId])
  @@map("twoFactor")
}

// ─────────────────────────────────────────────────────────────
// RBAC
// ─────────────────────────────────────────────────────────────

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(100) // "lessons.publish"
  groupName   String   @db.VarChar(50) // "content", "users", "settings"
  label       String   @db.VarChar(150)
  description String?  @db.VarChar(500)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  roles RolePermission[]
  users UserPermission[]

  @@index([groupName])
  @@map("permissions")
}

model Role {
  id                String   @id @default(cuid())
  key               String   @unique @db.VarChar(50) // "content_manager"
  name              String   @db.VarChar(100)
  description       String?  @db.VarChar(500)
  isSystem          Boolean  @default(false) // cannot be deleted
  level             Int      @default(0) // higher = more senior; guards escalation
  sortOrder         Int      @default(0)
  // ADR-183: the permission keys the SEED last granted this system role. A
  // deploy re-seeds, and diffing against this ledger is what lets it add a
  // key the code newly grants (or revoke one it stopped granting) without
  // undoing what an admin changed on the role since. Null on custom roles.
  seededPermissions Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedBy String?
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// Per-user override. DENY always wins over any role grant.
model UserPermission {
  userId       String
  permissionId String
  effect       PermissionEffect @default(ALLOW)
  reason       String?          @db.VarChar(500)
  assignedBy   String?
  assignedAt   DateTime         @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
  @@map("user_permissions")
}

enum PermissionEffect {
  ALLOW
  DENY
}

// ─────────────────────────────────────────────────────────────
// EMPLOYEES (HR context, distinct from auth identity)
// ─────────────────────────────────────────────────────────────

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  NOTICE_PERIOD
  TERMINATED
  RESIGNED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  FREELANCE
}

model Department {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  headId      String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]

  @@map("departments")
}

model Designation {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(50)
  title     String   @db.VarChar(100)
  level     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  @@map("designations")
}

model Employee {
  id           String  @id @default(cuid())
  // Nullable: an employee may exist before their login is provisioned.
  userId       String? @unique
  employeeCode String  @unique @db.VarChar(30)

  firstName     String  @db.VarChar(100)
  lastName      String  @db.VarChar(100)
  workEmail     String  @unique @db.VarChar(255)
  personalEmail String? @db.VarChar(255)
  phone         String? @db.VarChar(32)
  photoUrl      String? @db.VarChar(500)

  departmentId  String?
  designationId String?
  reportingToId String?

  employmentType EmploymentType   @default(FULL_TIME)
  status         EmploymentStatus @default(ACTIVE)
  joinedAt       DateTime
  confirmedAt    DateTime?
  exitedAt       DateTime?

  location       String? @db.VarChar(150)
  emergencyName  String? @db.VarChar(150)
  emergencyPhone String? @db.VarChar(32)
  notes          String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  department    Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation   Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  reportingTo   Employee?    @relation("EmployeeHierarchy", fields: [reportingToId], references: [id], onDelete: SetNull)
  directReports Employee[]   @relation("EmployeeHierarchy")

  @@index([departmentId])
  @@index([status])
  @@index([reportingToId])
  @@map("employees")
}

// ─────────────────────────────────────────────────────────────
// SETTINGS, FEATURE FLAGS, SOCIAL LINKS
// ─────────────────────────────────────────────────────────────

enum SettingType {
  STRING
  TEXT
  NUMBER
  BOOLEAN
  JSON
  IMAGE
  COLOR
  SELECT
  // changes-33 / ADR-110. A file that is not an image: today the three legal
  // documents, whose value is a site-relative path to a PDF. Kept distinct
  // from IMAGE rather than widened into it, because the two render different
  // controls (a preview thumbnail says nothing about a 40-page agreement) and
  // accept different bytes.
  DOCUMENT
}

model Setting {
  id             String      @id @default(cuid())
  groupName      String      @db.VarChar(50) // general | seo | social | layout | legal
  key            String      @unique @db.VarChar(120)
  value          Json?
  type           SettingType @default(STRING)
  label          String      @db.VarChar(150)
  description    String?     @db.VarChar(500)
  // Public settings are safe to ship to the browser bundle.
  isPublic       Boolean     @default(false)
  // Mirrors `TRANSLATABLE_SETTINGS` (@repo/contracts, ADR-165 #1): set by the
  // seed and the migration so the database agrees with the registry. The code
  // reads the registry, never this column.
  isTranslatable Boolean     @default(false)
  sortOrder      Int         @default(0)
  updatedBy      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  translations SettingTranslation[]

  @@index([groupName])
  @@map("settings")
}

/// A setting's words in another language (ADR-165 #3). Holds ONLY the
/// translated fields, always as an object: the named fields of a JSON value,
/// or `value` for a key whose whole value is text. Switches and URLs are never
/// here — they come from the English row, so a translation cannot change them.
/// No row is written for the default locale: its text is `settings.value`.
model SettingTranslation {
  id        String @id @default(cuid())
  settingId String
  locale    String @db.VarChar(10)
  value     Json

  /// A person's save writes TRANSLATED; only the job writes MACHINE_TRANSLATED,
  /// and only for a registry key the machine may translate (ADR-165 #6).
  translationStatus TranslationStatus @default(TRANSLATED)
  sourceHash        String?           @db.VarChar(64)
  updatedBy         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  setting Setting @relation(fields: [settingId], references: [id], onDelete: Cascade)

  @@unique([settingId, locale])
  @@index([locale])
  @@map("setting_translations")
}

enum FeatureVisibility {
  PUBLIC
  AUTHENTICATED
  PREMIUM
  ADMIN
}

model FeatureFlag {
  id          String            @id @default(cuid())
  key         String            @unique @db.VarChar(80) // "courses", "forums"
  label       String            @db.VarChar(150)
  description String?           @db.VarChar(500)
  isEnabled   Boolean           @default(false)
  visibility  FeatureVisibility @default(PUBLIC)
  groupName   String            @db.VarChar(50)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("feature_flags")
}

model SocialLink {
  id           String   @id @default(cuid())
  platform     String   @unique @db.VarChar(50) // instagram | facebook | youtube | linkedin | x
  label        String   @db.VarChar(100)
  url          String   @db.VarChar(500)
  // Built-in glyph key (@repo/ui social-glyph.tsx). Lucide brand icons
  // were removed in lucide v1, so this no longer names a lucide export.
  icon         String   @db.VarChar(80)
  // ADR-045: an admin-uploaded icon, which WINS over `icon` when set.
  // Null = use the built-in glyph. Stores the served URL, same shape as
  // every other uploaded asset reference (ADR-017).
  iconUrl      String?  @db.VarChar(500)
  handle       String?  @db.VarChar(100) // "@mbxproofficial"
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  openInNewTab Boolean  @default(true)
  showInHeader Boolean  @default(false)
  showInFooter Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("social_links")
}

// ADR-169 / changes-53: where the "Share your experience" band sends a
// reader, one row per REVIEW_PLATFORMS key (@repo/contracts). The set of
// platforms is code; the switch, order, identifier and override are data.
// The link is `customUrl` when set, else built from `identifier` by the
// registry. Public identifiers only — no credentials, nothing sealed.
model ReviewPlatform {
  id          String   @id @default(cuid())
  platform    String   @unique @db.VarChar(40) // trustpilot | google | facebook
  isEnabled   Boolean  @default(false)
  sortOrder   Int      @default(0)
  identifier  String?  @db.VarChar(200) // domain | Place ID | Page name
  customUrl   String?  @db.VarChar(500) // https only; wins over the built link
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("review_platforms")
}

// ─────────────────────────────────────────────────────────────
// THEMING
// ─────────────────────────────────────────────────────────────

model Theme {
  id          String  @id @default(cuid())
  key         String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String? @db.VarChar(500)

  // Tab 1 — Colors & Branding. Seven brand colours, shared across modes.
  brandColors Json

  // Tab 3 — Theme Modes. Surfaces, text, and borders authored per mode.
  lightSurface       Json
  darkSurface        Json
  // Only the brand keys that fail validation in dark mode. Usually two.
  darkBrandOverrides Json?

  // Tab 2 — Layout & Display. Radius, container width, font stacks.
  layoutTokens Json

  defaultMode ThemeMode @default(SYSTEM)
  // allowUserToggle intentionally dropped (plan.md A5.4, ADR-008): dark/light
  // is user-controlled, never admin-controlled.

  isActive Boolean @default(false)
  isSystem Boolean @default(false)
  scope    String  @default("both") @db.VarChar(20) // web | admin | both

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, scope])
  @@map("themes")
}

model BrandAsset {
  id           String   @id @default(cuid())
  key          String   @unique @db.VarChar(50) // logo_light | logo_dark | favicon (ADR-017/contracts' BrandAssetKey — the default OG image lives at the seo.defaultOgImage setting instead, one home per asset)
  url          String   @db.VarChar(500)
  // ADR-035 — the MediaAsset id url was resolved from, tracked so
  // deleteMedia's usage guard can see this reference.
  mediaAssetId String?
  altText      String?  @db.VarChar(255)
  width        Int?
  height       Int?
  mimeType     String?  @db.VarChar(100)
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("brand_assets")
}

// Uploaded files (changes-02, ADR-017). One row per stored object; the
// storage driver owns the bytes, this row owns the metadata the app needs
// to serve and audit them. `key` is the driver-side object name (random,
// extension-bearing); `url` is what pages embed.
// ADR-034 §1 — decided by magic bytes, never the client's declared type.
enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

model MediaAsset {
  id            String    @id @default(cuid())
  key           String    @unique @db.VarChar(120)
  url           String    @db.VarChar(500)
  fileName      String    @db.VarChar(255) // original client filename, display only
  mimeType      String    @db.VarChar(100)
  size          Int
  width         Int?
  height        Int?
  purpose       String    @db.VarChar(30) // brand | setting | article | content
  uploadedBy    String?
  createdAt     DateTime  @default(now())
  // ADR-034 §2 — the library's metadata. Existing rows backfill to
  // `kind: IMAGE`, `folder: "/"` via these column defaults (plan §5.2
  // pre-launch policy: a default carries a backfill, never a script).
  kind          MediaKind @default(IMAGE)
  title         String?   @db.VarChar(200)
  altText       String?   @db.VarChar(500) // default alt; a placement's translatable alt overrides it
  // ADR-066: the first segment is a registered category (`/news`, `/learn`,
  // `/brand`, `/general`); a sub-path below it is still free. Type is NOT in
  // this path — `kind` is the type axis, and duplicating it here would be a
  // second source of truth for a value magic bytes already decided.
  folder        String    @default("/general") @db.VarChar(300)
  tags          Json? // string[] — validated, lower-cased, <= 20 (ADR-034 Consequences: filtered in memory, not indexed)
  durationMs    Int?
  posterAssetId String? // VIDEO: a MediaAsset IMAGE id; required for background use (ADR-032 §2)
  version       Int       @default(1) // bumped by replace-in-place (ADR-034 §3)
  deletedAt     DateTime?

  @@index([purpose, createdAt])
  // ADR-067's dominant query is: folder prefix → kind → newest first. The
  // ADR-034 pair `[kind, folder]` had the columns the right way round for a
  // kind-first library that no longer exists.
  @@index([folder, kind, createdAt])
  @@index([deletedAt, createdAt])
  @@map("media_assets")
}

// ─────────────────────────────────────────────────────────────
// LOCALES & NAVIGATION
// ─────────────────────────────────────────────────────────────

enum TextDirection {
  LTR
  RTL
}

model Locale {
  id           String        @id @default(cuid())
  code         String        @unique @db.VarChar(10) // en, es, ar, ur
  name         String        @db.VarChar(100) // English
  nativeName   String        @db.VarChar(100) // English / العربية
  direction    TextDirection @default(LTR)
  flagEmoji    String?       @db.VarChar(10)
  isDefault    Boolean       @default(false)
  isActive     Boolean       @default(true)
  fallbackCode String?       @db.VarChar(10)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  messageOverrides MessageOverride[]

  @@index([isActive, sortOrder])
  @@map("locales")
}

/// One interface string replaced by an admin, in one language (ADR-178 #3).
/// Laid over that language's catalog file at request time; a language with no
/// file is made entirely of these. Public namespaces only — the service
/// refuses an admin key (ADR-043 #2). Deleted with its language.
model MessageOverride {
  id        String  @id @default(cuid())
  locale    String  @db.VarChar(10)
  /// Dotted catalog key, e.g. `home.hero.title`.
  key       String  @db.VarChar(191)
  value     String  @db.Text
  /// Written by "Translate missing with Google"; a person's save clears it.
  isMachine Boolean @default(false)
  /// A machine string a Sync "reset" queued for re-translation (ADR-191). It
  /// keeps its text until the new one lands; a person's save clears it.
  redo      Boolean @default(false)
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  language Locale @relation(fields: [locale], references: [code], onDelete: Cascade)

  @@unique([locale, key])
  @@map("message_overrides")
}

model Menu {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(50) // main | footer_learn | mobile
  name      String   @db.VarChar(100)
  location  String   @db.VarChar(50) // header | footer | sidebar
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MenuItem[]

  @@map("menus")
}

model MenuItem {
  id       String  @id @default(cuid())
  menuId   String
  parentId String?

  // Either an internal route or an external URL — not both.
  url      String? @db.VarChar(500)
  routeKey String? @db.VarChar(100)
  icon     String? @db.VarChar(80)
  badge    String? @db.VarChar(30)

  sortOrder          Int               @default(0)
  isActive           Boolean           @default(true)
  openInNewTab       Boolean           @default(false)
  visibility         FeatureVisibility @default(PUBLIC)
  // Hidden entirely when the named feature flag is off.
  requiresFeature    String?           @db.VarChar(80)
  requiresPermission String?           @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menu         Menu                  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent       MenuItem?             @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     MenuItem[]            @relation("MenuTree")
  translations MenuItemTranslation[]

  @@index([menuId, sortOrder])
  @@index([parentId])
  @@map("menu_items")
}

model MenuItemTranslation {
  id         String  @id @default(cuid())
  menuItemId String
  locale     String  @db.VarChar(10)
  label      String  @db.VarChar(150)
  title      String? @db.VarChar(255)

  /// ADR-161 #7: a row here was written by a person or the seed, so it is
  /// TRANSLATED; only the job runner writes MACHINE_TRANSLATED. Null hash =
  /// unknown, which sends an existing row through one review pass (#4).
  translationStatus TranslationStatus @default(TRANSLATED)
  sourceHash        String?           @db.VarChar(64)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, locale])
  @@map("menu_item_translations")
}

// ─────────────────────────────────────────────────────────────
// CONTENT — base + translation pattern
// Shown for Course/Lesson/Glossary. Articles, tools, pages follow identically
// (deferred to later modules per plan.md A7 — not blocking Phase 0).
// ─────────────────────────────────────────────────────────────

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// ADR-056 #5 — how a lesson becomes complete. Scroll-depth and
// video-percentage auto-completion are deliberately absent: both are
// unreliable, neither is testable at the DB level, and both write completion
// rows the learner did not intend. QUIZ_PASS is unreachable until Phase 6.
enum CompletionRule {
  MANUAL
  QUIZ_PASS
}

// ADR-058 #1. Ordering, matching, short answer and image questions are NOT
// implemented; the enum makes them additive rather than a migration of every
// existing row.
enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

// ADR-058 #4 — when the CORRECT ANSWER and its explanation may be revealed.
// NEVER also suppresses per-answer correctness during the attempt, because a
// live right/wrong counter is a correctness oracle and would make this setting
// a lie. AFTER_PASS still reveals correctness during the attempt (you learn you
// were wrong) and withholds the answer itself until you pass.
enum AnswerVisibility {
  NEVER
  AFTER_SUBMIT
  AFTER_PASS
}

// No NOT_STARTED member: the absence of a row IS "not started". Storing it
// would mean writing a row for every lesson a learner merely scrolled past.
enum LessonProgressStatus {
  IN_PROGRESS
  COMPLETED
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  SEO_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum TranslationStatus {
  DRAFT
  TRANSLATED
  NEEDS_REVIEW
  OUTDATED // source changed after this translation was written
  /// Written by a machine, not yet read by a human (ADR-097 / changes-29 B3).
  ///
  /// An enum member rather than a boolean on twelve translation tables,
  /// because it is genuinely a STATUS — and twelve columns saying one thing is
  /// the alternative. The AI path can write ONLY this value; a human opening
  /// the translation and pressing Save writes TRANSLATED through the existing
  /// action, so the review IS the promotion and no separate "approve" step is
  /// invented.
  ///
  /// ADR-159 (2026-09-26) replaced the rule this comment used to state:
  /// machine translations ARE served to readers, on every read path
  /// — but never INDEXED. `isIndexableTranslation` (@repo/core
  /// `translation-indexing.ts`) keeps them out of hreflang and the sitemap and
  /// sets the page's `noindex`, until a person's Save writes TRANSLATED. Only
  /// the translation job writes this member unattended (ADR-161 #2), and it
  /// never writes over any other status.
  MACHINE_TRANSLATED
}

// ADR-019: design-only — no service or UI code reads or writes this yet.
// The TABLE now exists (created by 20260906211059_article_editor_v2): the
// model had been in this schema without a migration since ADR-019, so every
// diff wanted to create it and each new migration failed on the leftover.
// Landing the empty table makes history match the schema; it does not build
// the feature, which is still unimplemented exactly as ADR-019 describes.
enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Course {
  id             String            @id @default(cuid())
  // LEARN_TRACKS registry key (ADR-055 #2). Validated in @repo/contracts, not
  // by a FK: a track is site structure, which ADR-042 keeps in code.
  track          String            @db.VarChar(40)
  difficulty     Difficulty        @default(BEGINNER)
  estimatedHours Int?
  // ADR-055 #6 — the MediaAsset id, not a URL. Plain String like
  // Article.coverImageAssetId (ADR-035): MediaAsset carries no back-relations.
  coverAssetId   String?
  // ADR-055 #5 — an external course. HTTPS-only, never fetched server-side.
  externalUrl    String?           @db.VarChar(500)
  // Denormalised published-lesson count, maintained by @repo/core in the same
  // transaction as the lesson write, so /learn costs one read rather than N.
  lessonCount    Int               @default(0)
  status         ContentStatus     @default(DRAFT)
  // ADR-139 — the article's three flags. `isActive` is part of the public
  // rule (hides without touching status); `isFeatured` is placement only;
  // `isPremium` is stored and labelled, not enforced.
  isFeatured     Boolean           @default(false)
  isActive       Boolean           @default(true)
  isPremium      Boolean           @default(false)
  visibility     FeatureVisibility @default(PUBLIC)
  sortOrder      Int               @default(0)
  authorId       String?
  publishedAt    DateTime?
  // ADR-071 — the instant this row becomes public. Nullable: only a SCHEDULED
  // row carries one, and moving to PUBLISHED or DRAFT clears it. Visibility is
  // decided in the query (PUBLISHED, or SCHEDULED whose time has come), so a
  // due row is live whether or not the sweep has run.
  scheduledFor   DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  // ADR-056 #7 / ADR-058 #1 — the course-level completion rule. Deliberately
  // NOT a phantom Lesson row: that would give it a slug, a URL, a position in
  // LessonProgress and a completionRule duplicating this very question.
  finalQuizId String?

  translations CourseTranslation[]
  sections     CourseSection[]
  enrollments  CourseEnrollment[]
  finalQuiz    Quiz?               @relation("CourseFinalQuiz", fields: [finalQuizId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([track, status, sortOrder])
  @@index([status, scheduledFor])
  @@map("courses")
}

model CourseTranslation {
  id       String @id @default(cuid())
  courseId String
  locale   String @db.VarChar(10)

  title       String  @db.VarChar(255)
  slug        String  @db.VarChar(255)
  summary     String? @db.Text
  description String? @db.LongText

  seoTitle        String? @db.VarChar(70)
  seoDescription  String? @db.VarChar(180)
  seoFocusKeyword String? @db.VarChar(100)
  ogImageUrl      String? @db.VarChar(500)

  // changes-49 (ADR-147): the course's own questions and answers, shaped like
  // `GlossaryTermTranslation.faq` — `[{ question, answer }]`, plain text,
  // per locale because both halves are translatable prose.
  faq Json?

  translationStatus TranslationStatus @default(DRAFT)
  translatedBy      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  /// ADR-161 #4: the English source's hash when this row was written. Null =
  /// unknown, never "current".
  sourceHash String? @db.VarChar(64)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, locale])
  @@unique([locale, slug])
  @@index([slug])
  @@map("course_translations")
}

// ADR-055 #1 — was `Module`. Renamed because "Module" already denotes a build
// unit in this repository ("Module 11"), and `db.module` beside a DEVLOG entry
// about Module 11 is a permanent ambiguity. Learner-facing word: "Section".
// A section groups lessons ON THE PAGE only — it never appears in a URL
// (ADR-055 #3), so reordering sections breaks no link.
model CourseSection {
  id          String   @id @default(cuid())
  courseId    String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course       Course                     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons      Lesson[]
  translations CourseSectionTranslation[]

  @@index([courseId, sortOrder])
  @@map("course_sections")
}

model CourseSectionTranslation {
  id          String  @id @default(cuid())
  sectionId   String
  locale      String  @db.VarChar(10)
  title       String  @db.VarChar(255)
  description String? @db.Text

  /// ADR-161 #7: a row here was written by a person or the seed, so it is
  /// TRANSLATED; only the job runner writes MACHINE_TRANSLATED. Null hash =
  /// unknown, which sends an existing row through one review pass (#4).
  translationStatus TranslationStatus @default(TRANSLATED)
  sourceHash        String?           @db.VarChar(64)

  section CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, locale])
  @@map("course_section_translations")
}

// ADR-055 #4 — capabilities, not types. A lesson is a bag of optional
// capabilities (content, videoUrl, attachments, externalUrl, quizId) and what
// it IS is derived from which are present. There is deliberately no
// `LessonType` enum: it would make illegal combinations representable and put
// a switch in every consumer. `lessonInputSchema` enforces that at least one
// capability is set, so an empty lesson cannot be saved.
model Lesson {
  id                   String            @id @default(cuid())
  sectionId            String
  difficulty           Difficulty        @default(BEGINNER)
  estimatedMinutes     Int?
  // External embed URL — genuinely not an asset, so it stays a string.
  // Validated by parseVideoUrl(); the iframe is rebuilt at render, never
  // stored (ADR-055 #5).
  videoUrl             String?           @db.VarChar(500)
  // ADR-055 #5 — an external resource. HTTPS-only, never fetched
  // server-side, framed only if parseVideoUrl() accepts it; else a link.
  externalUrl          String?           @db.VarChar(500)
  // ADR-055 #6 — MediaAsset id, not a URL (see Course.coverAssetId).
  heroAssetId          String?
  // ADR-056 #5. MANUAL works identically for text, video, PDF and external
  // lessons, which is what makes external resources cheap to support: we
  // cannot observe what a learner does on someone else's site.
  completionRule       CompletionRule    @default(MANUAL)
  // Optional material does not block course completion (ADR-056 #7).
  isRequired           Boolean           @default(true)
  prerequisiteLessonId String?
  // ADR-058 #1 — the lesson's quiz. SetNull, not Cascade: deleting a quiz must
  // never delete the lesson that used it. A QUIZ_PASS lesson left without one
  // is treated as non-blocking by recomputeCourseCompletion (ADR-058
  // consequences) rather than making the course impossible to finish.
  quizId               String?
  sortOrder            Int               @default(0)
  status               ContentStatus     @default(DRAFT)
  // ADR-139 — the article's three flags. `isActive` is part of the public
  // rule (hides without touching status); `isFeatured` is placement only;
  // `isPremium` is stored and labelled, not enforced.
  isFeatured           Boolean           @default(false)
  isActive             Boolean           @default(true)
  isPremium            Boolean           @default(false)
  visibility           FeatureVisibility @default(PUBLIC)
  authorId             String?
  publishedAt          DateTime?
  // ADR-071 — the instant this row becomes public. Nullable: only a SCHEDULED
  // row carries one, and moving to PUBLISHED or DRAFT clears it. Visibility is
  // decided in the query (PUBLISHED, or SCHEDULED whose time has come), so a
  // due row is live whether or not the sweep has run.
  scheduledFor         DateTime?
  lastReviewedAt       DateTime?
  viewCount            Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  deletedAt            DateTime?

  section      CourseSection       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  translations LessonTranslation[]
  attachments  LessonAttachment[]
  progress     LessonProgress[]
  feedback     LessonFeedback[]
  quiz         Quiz?               @relation("LessonQuiz", fields: [quizId], references: [id], onDelete: SetNull)

  @@index([sectionId, sortOrder])
  @@index([status, publishedAt])
  @@index([status, scheduledFor])
  @@map("lessons")
}

model LessonTranslation {
  id       String @id @default(cuid())
  lessonId String
  locale   String @db.VarChar(10)

  title              String  @db.VarChar(255)
  slug               String  @db.VarChar(255)
  summary            String? @db.Text
  content            String? @db.LongText
  learningObjectives Json?

  seoTitle        String? @db.VarChar(70)
  seoDescription  String? @db.VarChar(180)
  seoFocusKeyword String? @db.VarChar(100)

  translationStatus TranslationStatus @default(DRAFT)
  // Hash of the source-locale content at translation time. When the source
  // changes, the hash mismatch flips this row to OUTDATED automatically.
  sourceHash        String?           @db.VarChar(64)
  translatedBy      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  /// ADR-161 #8: this lesson's attachment labels, English label → translated
  /// label. On the parent row, not a table, because `saveLesson` recreates
  /// every attachment on each save and would delete a table's rows with them.
  attachmentLabels Json?

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, locale])
  @@unique([locale, slug])
  @@index([translationStatus])
  @@map("lesson_translations")
}

// ADR-055 #4/#6 — PDFs and downloads attached to a lesson. `assetId` is a
// MediaAsset id held as a plain String, matching Article.coverImageAssetId
// (ADR-035); the placement is mirrored into ContentReference so
// deleteMedia()'s in-use guard sees it.
model LessonAttachment {
  id        String   @id @default(cuid())
  lessonId  String
  assetId   String
  sortOrder Int      @default(0)
  // Display-only. A translatable label is deferred until an editor asks for
  // one — the file name carries the meaning today.
  label     String?  @db.VarChar(200)
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, sortOrder])
  @@map("lesson_attachments")
}

// ADR-056 #2 — one row per (user, lesson).
//
// `courseId` is denormalised on purpose. The course page asks "which of this
// course's lessons has this user completed" on every load; without it that is
// progress -> lesson -> section -> course, with it one index seek. The write
// path sets it inside the same transaction that resolves the lesson, so it
// cannot drift.
model LessonProgress {
  id           String               @id @default(cuid())
  userId       String
  lessonId     String
  courseId     String
  status       LessonProgressStatus @default(IN_PROGRESS)
  completedAt  DateTime?
  // ADR-134 — the last time the learner OPENED this lesson. Moved by every
  // visit (`touchLesson`), which `updatedAt` is not: the touch's upsert leaves
  // an existing row untouched on purpose, so it never downgrades a completion.
  // A last-read marker like ArticleRead.readAt (ADR-123 §2), not a view log.
  lastViewedAt DateTime             @default(now())
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId]) // makes "mark complete" idempotent
  @@index([userId, lastViewedAt]) // /account/progress: recently read lessons
  @@index([userId, courseId]) // course page: one indexed read
  @@index([lessonId, status]) // analytics: drop-off per lesson
  @@map("lesson_progress")
}

// ADR-056 #2 — one row per (user, course). `lessonsCompleted` is denormalised
// and maintained ONLY inside the same transaction as the LessonProgress write;
// a concurrency test asserts it equals the distinct completed-lesson count.
model CourseEnrollment {
  id               String    @id @default(cuid())
  userId           String
  courseId         String
  lastLessonId     String? // drives "Continue Learning"
  lessonsCompleted Int       @default(0)
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  lastActiveAt     DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, lastActiveAt]) // learner dashboard
  @@index([courseId, completedAt]) // admin analytics
  @@map("course_enrollments")
}

// ADR-056 #8 — one row per vote, not a pair of counters on Lesson.
//
// Counters would answer "what is the ratio right now" and nothing else. A row
// per vote answers "which lessons got worse after the March rewrite", which is
// the question an editor actually asks, and it is the reason Phase 9's
// least-helpful report is a query rather than a new feature.
//
// **The unique constraint binds SIGNED-IN learners only, and that is
// deliberate.** MariaDB treats NULLs as distinct in a unique index, so
// anonymous rows (userId NULL) accumulate freely while a learner with an
// account can only hold one vote per lesson. Do not "fix" this to a filtered
// or partial index — the behaviour is the design. Anonymous duplicates are
// bounded by the endpoint's per-IP rate limit and deduped per browser in
// localStorage, which is UX rather than security and is stated as such.
//
// The optional `user` relation is one addition to ADR-056 #8's sketch, which
// had `userId` as a bare column: deleting a learner has to take their votes
// with it, exactly as it does for LessonProgress and CourseEnrollment, rather
// than leaving rows attributable to a dangling id.
model LessonFeedback {
  id        String   @id @default(cuid())
  lessonId  String
  userId    String?
  helpful   Boolean
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
  @@index([lessonId, helpful]) // the editorial rollup
  @@map("lesson_feedback")
}

// ADR-058 #1 — the quiz is the entity and consumers point AT it
// (Lesson.quizId, Course.finalQuizId). Nullable courseId/lessonId here was the
// alternative and it makes illegal states representable — both set, or a quiz
// attached to a lesson in another course — while making reuse impossible.
model Quiz {
  id               String           @id @default(cuid())
  // LEARN_TRACKS registry key (ADR-065 §3). Required, unlike GlossaryTerm's:
  // a quiz has ONE canonical URL, /learn/<track>/quizzes/<slug>, and that
  // segment cannot be built from a null. Validated in @repo/contracts, not by
  // a FK — a track is site structure, which ADR-042 keeps in code.
  track            String           @db.VarChar(40)
  // Percentage. A learner passes at or above it.
  passingScore     Int              @default(70)
  // Null means unlimited, which is the default and the right one for a
  // learning site (D24).
  maxAttempts      Int?
  showAnswersAfter AnswerVisibility @default(AFTER_SUBMIT)
  // Listing only, never access control: a lesson quiz stays reachable by slug,
  // it is simply not indexed at /learn/quizzes (ADR-058 #1).
  isStandalone     Boolean          @default(false)
  // Editorial grouping for the index's client-side chips. Free text like
  // GlossaryTerm.category, and it reaches the screen through a label map, never
  // raw (ADR-044 #5's public counterpart).
  category         String?          @db.VarChar(80)
  // ADR-132 — the editor's cover, a MediaAsset id like Course.coverAssetId
  // (ADR-055 #6). Null falls back to the generated panel `quizCoverUrl` picks
  // from the slug, so a quiz nobody gave a picture still has one.
  coverAssetId     String?

  status       ContentStatus     @default(DRAFT)
  // ADR-139 — the article's three flags. `isActive` is part of the public
  // rule (hides without touching status); `isFeatured` is placement only;
  // `isPremium` is stored and labelled, not enforced.
  isFeatured   Boolean           @default(false)
  isActive     Boolean           @default(true)
  isPremium    Boolean           @default(false)
  visibility   FeatureVisibility @default(PUBLIC)
  authorId     String?
  publishedAt  DateTime?
  // ADR-071 — the instant this row becomes public. Nullable: only a SCHEDULED
  // row carries one, and moving to PUBLISHED or DRAFT clears it. Visibility is
  // decided in the query (PUBLISHED, or SCHEDULED whose time has come), so a
  // due row is live whether or not the sweep has run.
  scheduledFor DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  translations QuizTranslation[]
  questions    QuizQuestion[]
  attempts     QuizAttempt[]
  lessons      Lesson[]          @relation("LessonQuiz")
  courses      Course[]          @relation("CourseFinalQuiz")

  @@index([status, publishedAt])
  @@index([isStandalone, status])
  @@index([track, isStandalone, status])
  @@index([status, scheduledFor])
  @@map("quizzes")
}

model QuizTranslation {
  id          String  @id @default(cuid())
  quizId      String
  locale      String  @db.VarChar(10)
  title       String  @db.VarChar(255)
  slug        String  @db.VarChar(255)
  description String? @db.Text

  translationStatus TranslationStatus @default(DRAFT)
  sourceHash        String?           @db.VarChar(64)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, locale])
  @@unique([locale, slug])
  @@map("quiz_translations")
}

// ADR-058 #2 — the CORRECT ANSWER lives here, on the untranslated row, and
// never on a translation. A correct-answer index is not language, and putting
// it in a translation lets a translator desync it from every other locale.
//
// correctAnswer is a JSON number for SINGLE_CHOICE/TRUE_FALSE and a JSON array
// of numbers for MULTIPLE_CHOICE, indexing into the translation's options.
// Parsed through Zod on write and on read; the database will not stop a bad
// write from another codepath, and there is exactly one writer.
model QuizQuestion {
  id            String       @id @default(cuid())
  quizId        String
  type          QuestionType @default(SINGLE_CHOICE)
  sortOrder     Int          @default(0)
  correctAnswer Json
  points        Int          @default(1)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  quiz         Quiz                      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  translations QuizQuestionTranslation[]

  @@index([quizId, sortOrder])
  @@map("quiz_questions")
}

model QuizQuestionTranslation {
  id           String @id @default(cuid())
  questionId   String
  locale       String @db.VarChar(10)
  prompt       String @db.Text
  // Option LABELS, in order. The index into this array is what correctAnswer
  // names, which is why reordering options in the admin has to move the
  // correct-answer index with them.
  options      Json
  // Per-option explanation, shown in review when showAnswersAfter allows.
  // Optional and sparse — an editor explains the ones worth explaining.
  explanations Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ADR-161 #7: a row here was written by a person or the seed, so it is
  /// TRANSLATED; only the job runner writes MACHINE_TRANSLATED. Null hash =
  /// unknown, which sends an existing row through one review pass (#4).
  translationStatus TranslationStatus @default(TRANSLATED)
  sourceHash        String?           @db.VarChar(64)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, locale])
  @@map("quiz_question_translations")
}

// ADR-058 #3/#5 — one row per attempt, answers as JSON.
//
// The answers are only ever read as a whole set, for one attempt, by one user;
// no query filters on them. A QuizAttemptAnswer table would be
// rows-per-question-per-attempt for zero query benefit. The one analytic it
// forecloses is "most frequently missed questions" (Phase 9), and THAT is the
// trigger for adding one — nothing else in the analytics set needs it.
//
// grades is the server's own record of which questions were answered
// correctly, written as each answer arrives. The final score is computed from
// it, never from anything the browser sends at submit time.
model QuizAttempt {
  id            String    @id @default(cuid())
  quizId        String
  userId        String
  attemptNumber Int       @default(1)
  score         Int       @default(0)
  percentage    Int       @default(0)
  passed        Boolean   @default(false)
  answers       Json
  grades        Json
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([quizId, userId, attemptNumber])
  @@index([quizId, userId])
  @@index([userId, completedAt])
  @@map("quiz_attempts")
}

model GlossaryTerm {
  id           String        @id @default(cuid())
  // ADR-055 #12 (D27) — was `category String?`, free text with no slug, no
  // translation, no description, no ordering and no page to link to. It could
  // not support "browse by topic" and it broke two rules we already hold:
  // ADR-044 #5 (a raw identifier never renders) and ADR-043 #1 (public strings
  // are translatable). Pre-launch reset, no backfill.
  topicId      String?
  // LEARN_TRACKS registry key, or NULL (ADR-065 §3). Null does NOT mean
  // unfiled — it means the term belongs to EVERY track's glossary, which is
  // the honest state for "leverage", "spread" and "volatility". Duplicating
  // those per track would give one concept two pages competing in search.
  track        String?       @db.VarChar(40)
  difficulty   Difficulty    @default(BEGINNER)
  formula      String?       @db.Text
  imageUrl     String?       @db.VarChar(500)
  status       ContentStatus @default(DRAFT)
  // ADR-139 — the article's three flags. `isActive` is part of the public
  // rule (hides without touching status); `isFeatured` is placement only;
  // `isPremium` is stored and labelled, not enforced.
  isFeatured   Boolean       @default(false)
  isActive     Boolean       @default(true)
  isPremium    Boolean       @default(false)
  viewCount    Int           @default(0)
  authorId     String?
  publishedAt  DateTime?
  // ADR-071 — the instant this row becomes public. Nullable: only a SCHEDULED
  // row carries one, and moving to PUBLISHED or DRAFT clears it. Visibility is
  // decided in the query (PUBLISHED, or SCHEDULED whose time has come), so a
  // due row is live whether or not the sweep has run.
  scheduledFor DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  translations GlossaryTermTranslation[]
  topic        GlossaryTopic?            @relation(fields: [topicId], references: [id], onDelete: SetNull)

  // SetNull, not Cascade: deleting a topic must never delete the terms filed
  // under it. They fall back to untopiced and stay in the A–Z browse.
  @@index([topicId])
  @@index([status])
  @@index([track, status])
  @@index([status, scheduledFor])
  @@map("glossary_terms")
}

// ADR-055 #12 (D27) — mirrors ArticleCategory / ArticleCategoryTranslation
// EXACTLY. That is the point: it is a proven pattern in this repo, so there is
// nothing new to design and the admin screens are the same shape.
model GlossaryTopic {
  id           String   @id @default(cuid())
  isActive     Boolean  @default(true)
  // ADR-139 — with `isActive` above, the article's three flags.
  isFeatured   Boolean  @default(false)
  isPremium    Boolean  @default(false)
  sortOrder    Int      @default(0)
  // ADR-133 — the editor's cover, a MediaAsset id like Quiz.coverAssetId
  // (ADR-132). Belongs to the topic, not a language. Null falls back to the
  // glossary's own topic artwork, so a topic nobody gave a picture has one.
  coverAssetId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  translations GlossaryTopicTranslation[]
  terms        GlossaryTerm[]

  @@index([isActive, sortOrder])
  @@map("glossary_topics")
}

model GlossaryTopicTranslation {
  id      String @id @default(cuid())
  topicId String
  locale  String @db.VarChar(10)

  name           String  @db.VarChar(100)
  slug           String  @db.VarChar(150)
  // Rich text, not a caption (changes-18 PR 3). It was VarChar(500) because a
  // topic was a row in an inline manager; it is now a page with an editor, and
  // the public topic page renders it as prose. Sanitized server-side on save
  // like every other rich field (security.md #8), and read back through
  // `htmlToText` wherever it is used AS a string — the bug ADR-069 recorded
  // for `simpleExplanation`.
  description    String? @db.Text
  seoTitle       String? @db.VarChar(70)
  seoDescription String? @db.VarChar(180)
  // Plural and free text: the meta keywords tag, not a focus term.
  // `SeoAnalysis` scores prose against ONE keyword and a topic page has no
  // prose to score, so `seoFocusKeyword` would promise an analysis that is
  // not there (changes-18 §2 D4).
  seoKeywords    String? @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ADR-161 #7: a row here was written by a person or the seed, so it is
  /// TRANSLATED; only the job runner writes MACHINE_TRANSLATED. Null hash =
  /// unknown, which sends an existing row through one review pass (#4).
  translationStatus TranslationStatus @default(TRANSLATED)
  sourceHash        String?           @db.VarChar(64)

  topic GlossaryTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, locale])
  @@unique([locale, slug])
  @@index([slug])
  @@map("glossary_topic_translations")
}

model GlossaryTermTranslation {
  id     String @id @default(cuid())
  termId String
  locale String @db.VarChar(10)

  term                String  @db.VarChar(150)
  slug                String  @db.VarChar(150)
  simpleExplanation   String  @db.Text
  detailedExplanation String? @db.LongText
  advancedExplanation String? @db.LongText
  exampleScenario     String? @db.Text
  faq                 Json?

  seoTitle       String? @db.VarChar(70)
  seoDescription String? @db.VarChar(180)

  translationStatus TranslationStatus @default(DRAFT)
  sourceHash        String?           @db.VarChar(64)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  glossaryTerm GlossaryTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([termId, locale])
  @@unique([locale, slug])
  @@index([slug])
  @@map("glossary_term_translations")
}

// ─────────────────────────────────────────────────────────────
// VIDEOS — the fourth learn section (Module 11/12, ADR-068)
//
// A video topic is a PAGE whose subject is a video. It is not a Lesson, it
// belongs to no Course, and nothing about it is graded — which is why it is
// its own entity rather than a Lesson variant (ADR-068 §2): every Lesson
// column about ordering, completion and progress would be dead on it, and
// `lessonsCompleted` would have to learn to ignore a kind of Lesson.
//
// Categories mirror GlossaryTopic / ArticleCategory exactly, on purpose.
// ─────────────────────────────────────────────────────────────

model VideoCategory {
  id        String   @id @default(cuid())
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations VideoCategoryTranslation[]
  topics       VideoTopic[]

  @@index([isActive, sortOrder])
  @@map("video_categories")
}

model VideoCategoryTranslation {
  id         String @id @default(cuid())
  categoryId String
  locale     String @db.VarChar(10)

  name           String  @db.VarChar(100)
  slug           String  @db.VarChar(150)
  description    String? @db.VarChar(500)
  seoTitle       String? @db.VarChar(70)
  seoDescription String? @db.VarChar(180)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ADR-161 #7: a row here was written by a person or the seed, so it is
  /// TRANSLATED; only the job runner writes MACHINE_TRANSLATED. Null hash =
  /// unknown, which sends an existing row through one review pass (#4).
  translationStatus TranslationStatus @default(TRANSLATED)
  sourceHash        String?           @db.VarChar(64)

  category VideoCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@index([slug])
  @@map("video_category_translations")
}

model VideoTopic {
  id String @id @default(cuid())

  // SetNull, not Cascade: deleting a category must never delete the pages
  // filed under it — the same call Lesson.quizId makes.
  categoryId   String?
  // Required (ADR-068 §1, following ADR-065 §3): the track is the URL's second
  // segment, not a filter over one, so it cannot be built from a null. Width
  // matches Course.track / Quiz.track — one track registry, one column shape.
  track        String  @db.VarChar(40)
  // MediaAsset id as a plain String (ADR-035) — no FK, so deleting an asset
  // cannot cascade into content. `ContentReference` is the integrity index.
  coverAssetId String?

  status          ContentStatus     @default(DRAFT)
  // ADR-139 — the article's three flags. `isActive` is part of the public
  // rule (hides without touching status); `isFeatured` is placement only;
  // `isPremium` is stored and labelled, not enforced.
  isFeatured      Boolean           @default(false)
  isActive        Boolean           @default(true)
  isPremium       Boolean           @default(false)
  // ADR-144 §2 — also LISTED on every other school's video index and
  // category pages. `track` stays the one canonical address: those listings
  // link to it, and the topic under any other track still 404s.
  showOnAllTracks Boolean           @default(false)
  visibility      FeatureVisibility @default(PUBLIC)
  authorId        String?
  publishedAt     DateTime?
  // ADR-071 — the instant this row becomes public. Nullable: only a SCHEDULED
  // row carries one, and moving to PUBLISHED or DRAFT clears it. Visibility is
  // decided in the query (PUBLISHED, or SCHEDULED whose time has come), so a
  // due row is live whether or not the sweep has run.
  scheduledFor    DateTime?
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  category     VideoCategory?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  translations VideoTopicTranslation[]
  videos       VideoTopicVideo[]
  links        VideoTopicLink[]

  @@index([status, publishedAt])
  @@index([track, status])
  @@index([categoryId, sortOrder])
  @@index([status, scheduledFor])
  @@map("video_topics")
}

model VideoTopicTranslation {
  id      String @id @default(cuid())
  topicId String
  locale  String @db.VarChar(10)

  title   String  @db.VarChar(255)
  slug    String  @db.VarChar(255)
  summary String? @db.Text
  content String? @db.LongText // sanitized on save (security.md #8)

  seoTitle        String? @db.VarChar(70)
  seoDescription  String? @db.VarChar(180)
  seoFocusKeyword String? @db.VarChar(100)

  translationStatus TranslationStatus @default(DRAFT)
  sourceHash        String?           @db.VarChar(64)
  translatedBy      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  /// ADR-161 #8: this topic's link labels, English label → translated label,
  /// for the reason `LessonTranslation.attachmentLabels` gives.
  linkLabels Json?

  topic VideoTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, locale])
  @@unique([locale, slug])
  @@index([translationStatus])
  @@map("video_topic_translations")
}

// Exactly one of assetId / externalUrl is set (ADR-068 §4) — enforced in
// @repo/contracts, because MariaDB CHECK constraints are not in this repo's
// vocabulary and a second enforcement point that can disagree with the first
// is worse than one that cannot.
model VideoTopicVideo {
  id            String   @id @default(cuid())
  topicId       String
  sortOrder     Int      @default(0)
  assetId       String? // MediaAsset, kind VIDEO
  externalUrl   String?  @db.VarChar(500)
  posterAssetId String? // MediaAsset, kind IMAGE — the uploaded video's poster
  title         String?  @db.VarChar(200) // display-only, not translatable (ADR-068 §4)
  createdAt     DateTime @default(now())

  topic VideoTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, sortOrder])
  @@map("video_topic_videos")
}

// Exactly one of path / url is set (ADR-068 §5). There is deliberately no
// `isExternal` column: which branch is set already says it, and a stored copy
// goes stale the first time a link is edited.
model VideoTopicLink {
  id        String   @id @default(cuid())
  topicId   String
  sortOrder Int      @default(0)
  label     String   @db.VarChar(200)
  path      String?  @db.VarChar(500) // site-relative, one leading "/"
  url       String?  @db.VarChar(500) // https only
  createdAt DateTime @default(now())

  topic VideoTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, sortOrder])
  @@map("video_topic_links")
}

// ─────────────────────────────────────────────────────────────
// NEWS & ANALYSIS — articles (Module 15, ADR-015; plan.md A7 shape)
// Bodies are sanitized HTML (ADR-009). Slugs live on translation rows.
// ─────────────────────────────────────────────────────────────

enum ArticleKind {
  NEWS
  ANALYSIS
  TRADE_IDEA
}

model ArticleCategory {
  id        String   @id @default(cuid())
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations ArticleCategoryTranslation[]
  articles     Article[]

  @@index([isActive, sortOrder])
  @@map("article_categories")
}

model ArticleCategoryTranslation {
  id         String @id @default(cuid())
  categoryId String
  locale     String @db.VarChar(10)

  name           String  @db.VarChar(100)
  slug           String  @db.VarChar(150)
  description    String? @db.VarChar(500)
  seoTitle       String? @db.VarChar(70)
  seoDescription String? @db.VarChar(180)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ADR-161 #7: a row here was written by a person or the seed, so it is
  /// TRANSLATED; only the job runner writes MACHINE_TRANSLATED. Null hash =
  /// unknown, which sends an existing row through one review pass (#4).
  translationStatus TranslationStatus @default(TRANSLATED)
  sourceHash        String?           @db.VarChar(64)

  category ArticleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@index([slug])
  @@map("article_category_translations")
}

model ArticleTag {
  id        String   @id @default(cuid())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations ArticleTagTranslation[]
  articles     ArticleTagAssignment[]

  @@map("article_tags")
}

model ArticleTagTranslation {
  id        String   @id @default(cuid())
  tagId     String
  locale    String   @db.VarChar(10)
  name      String   @db.VarChar(100)
  slug      String   @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ADR-161 #7: a row here was written by a person or the seed, so it is
  /// TRANSLATED; only the job runner writes MACHINE_TRANSLATED. Null hash =
  /// unknown, which sends an existing row through one review pass (#4).
  translationStatus TranslationStatus @default(TRANSLATED)
  sourceHash        String?           @db.VarChar(64)

  tag ArticleTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, locale])
  @@unique([locale, slug])
  @@index([slug])
  @@map("article_tag_translations")
}

model Article {
  id        String        @id @default(cuid())
  kind      ArticleKind   @default(NEWS)
  // Reuses the shared enum; articles run a leaner transition map (ADR-015 #4)
  // — the review states are unused here.
  status    ContentStatus @default(DRAFT)
  // Instant hide/show without touching status (ADR-015 #4).
  isActive  Boolean       @default(true)
  // Schema-ready, unenforced until entitlements land (ADR-012 reference).
  isPremium Boolean       @default(false)

  coverImageUrl     String? @db.VarChar(500)
  // ADR-035 — the MediaAsset id behind coverImageUrl, tracked so deleteMedia's
  // usage guard can see this reference. Null for rows saved before ADR-035
  // or set via an external URL rather than the upload widget.
  coverImageAssetId String?
  // Featured video — validated against the @repo/utils provider whitelist;
  // embed iframes are constructed at render, never stored (ADR-015 #9).
  videoUrl          String? @db.VarChar(500)

  categoryId String
  authorId   String?

  // Ingestion-ready (null for admin-authored articles; worker is deferred).
  source    String? @db.VarChar(150)
  sourceUrl String? @db.VarChar(500)

  // changes-07 PR 2 — editor v2 fields.
  // Editorial promotion flag. Public consumers are a listing decision under
  // ADR-042's philosophy; nothing reads it yet beyond the admin list.
  isFeatured         Boolean @default(false)
  // Distinct from coverImageUrl: rendered at the top of THIS article's page,
  // where the cover is the card/OG image. ADR-035 asset pairing as usual.
  headerImageUrl     String? @db.VarChar(500)
  headerImageAssetId String?
  // Related posts are rows in ContentRelation (sourceType "article",
  // relationType "related"); these two only control rendering.
  showRelated        Boolean @default(true)
  relatedCount       Int     @default(3)

  scheduledFor DateTime?
  publishedAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  category     ArticleCategory        @relation(fields: [categoryId], references: [id])
  translations ArticleTranslation[]
  tags         ArticleTagAssignment[]
  // ADR-019, design-only — see Comment.
  comments     Comment[]
  // ADR-123 — signed-in learners who opened this article.
  reads        ArticleRead[]

  @@index([kind, status, publishedAt])
  @@index([isFeatured, status, publishedAt])
  @@index([status, scheduledFor])
  @@index([categoryId])
  @@map("articles")
}

model ArticleTranslation {
  id        String @id @default(cuid())
  articleId String
  locale    String @db.VarChar(10)

  title   String  @db.VarChar(255)
  slug    String  @db.VarChar(255)
  excerpt String? @db.VarChar(500)
  // Sanitized HTML — every save path goes through sanitizeRichText (ADR-009).
  body    String? @db.LongText

  /// `string[]`, 3-5 entries, each ≤160 chars (changes-29 B4).
  ///
  /// An ORDINARY content column with an ordinary editor control: no field
  /// exists here only because AI does (ADR-097 / §2.2 #8). The Generate button
  /// beside it is the optional half, which is what makes "the CMS keeps
  /// working with AI off" structural rather than a promise — with AI off this
  /// is a list an editor types.
  ///
  /// Json rather than a child table: it is an ordered list of short strings
  /// with no identity of its own, read and written whole, and a
  /// `ArticleTakeaway` table would buy nothing but a join.
  keyTakeaways Json?

  seoTitle            String? @db.VarChar(70)
  seoDescription      String? @db.VarChar(180)
  ogImageUrl          String? @db.VarChar(500)
  // ADR-035 — same purpose as Article.coverImageAssetId, scoped per translation.
  ogImageAssetId      String?
  canonicalUrl        String? @db.VarChar(500)
  noIndex             Boolean @default(false)
  // changes-07 PR 2 — per-locale SEO, matching the reference editor.
  // Comma-separated; parsed by @repo/utils parseKeywords, never split in SQL.
  focusKeywords       String? @db.VarChar(300)
  noFollow            Boolean @default(false)
  // Open Graph / Twitter overrides. Both fall back to seoTitle → title and
  // seoDescription → excerpt at render; null means inherit, not empty.
  ogTitle             String? @db.VarChar(120)
  ogDescription       String? @db.VarChar(300)
  twitterCard         String? @db.VarChar(20)
  twitterImageUrl     String? @db.VarChar(500)
  twitterImageAssetId String?

  translationStatus TranslationStatus @default(DRAFT)
  sourceHash        String?           @db.VarChar(64)
  translatedBy      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  article  Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  faqItems ArticleFaqItem[]

  @@unique([articleId, locale])
  @@unique([locale, slug])
  @@index([slug])
  @@map("article_translations")
}

// ADR-123 — one row per (learner, article), moved forward on every re-read.
//
// A LAST-READ marker, not an event log: the profile page asks "what did I
// read recently", which one row per pair answers, and a row per page view
// would grow without bound to answer a question nobody asks. `readAt` is the
// only thing an upsert changes, which is why it carries no `@updatedAt`.
//
// Keyed to the ARTICLE, not a translation: switching locale is not reading a
// second article, and the page resolves the title in the reader's locale.
model ArticleRead {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  readAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, readAt]) // the profile page, newest first
  @@index([articleId])
  @@map("article_reads")
}

// changes-07 PR 2. Keyed to the TRANSLATION, not the article: a question and
// its answer are translatable prose, so they are naturally per-locale and
// cascade with the translation — no second translation table, no orphan-locale
// case. Answers are sanitized HTML through the same ADR-009 pipeline as bodies.
model ArticleFaqItem {
  id            String @id @default(cuid())
  translationId String
  sortOrder     Int    @default(0)
  question      String @db.VarChar(300)
  answer        String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translation ArticleTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@index([translationId, sortOrder])
  @@map("article_faq_items")
}

model ArticleTagAssignment {
  articleId String
  tagId     String
  createdAt DateTime @default(now())

  article Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     ArticleTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("article_tag_assignments")
}

// ADR-019: design-only — see the comment on CommentStatus above. Not
// migrated, not read/written by any service or route yet.
model Comment {
  id        String        @id @default(cuid())
  articleId String
  userId    String
  // Plain text, not sanitized HTML (ADR-009 governs rich bodies; a comment
  // is not one) — rendered escaped, never dangerouslySetInnerHTML.
  body      String        @db.VarChar(2000)
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId, status, createdAt])
  @@index([userId])
  @@map("comments")
}

// Generic cross-entity linking (lesson → glossary → tool → analysis)
model ContentRelation {
  id           String   @id @default(cuid())
  sourceType   String   @db.VarChar(50)
  sourceId     String
  targetType   String   @db.VarChar(50)
  targetId     String
  relationType String   @default("related") @db.VarChar(50)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([sourceType, sourceId, targetType, targetId, relationType], name: "uniq_relation")
  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
  @@map("content_relations")
}

// ─────────────────────────────────────────────────────────────
// AUDIT
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   @db.VarChar(100) // "theme.update", "user.role.assign"
  entityType String?  @db.VarChar(50)
  entityId   String?
  changes    Json? // { before: {...}, after: {...} }
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// NOTIFICATIONS (ADR-014)
// ─────────────────────────────────────────────────────────────

// Per-user admin notifications — presentation, not record (AuditLog is the
// record). Written only by @repo/core's recordNotification, read only
// scoped to the recipient's own userId; no cross-user read path exists, so
// no permission key guards it. Retention sweep: Module 14.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    @db.VarChar(100) // "role.assigned", "password.reset"
  title     String    @db.VarChar(200)
  body      String?   @db.VarChar(500)
  href      String?   @db.VarChar(500) // admin-relative link target
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique @db.VarChar(500)
  toPath     String   @db.VarChar(500)
  statusCode Int      @default(301)
  isActive   Boolean  @default(true)
  hitCount   Int      @default(0)
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([fromPath])
  @@map("redirects")
}

// ─────────────────────────────────────────────────────────────
// WEBSITE BUILDER / CMS (Module 16) — page model
// ADR-021 (Page/PageTranslation/PageVersion) + ADR-032 §6 amendments
// (revision/gateResult/templateKey, updatedById/parentId/group) +
// ADR-033 §4 (ContentReference). `PageKind` gains PART in Phase 6
// (ADR-027) — not added yet, no PART rows exist to migrate.
// Layout is Json, Zod-validated in @repo/contracts on every read/write
// (the full node-envelope schema lands in Phase 2 per ADR-032).
// ─────────────────────────────────────────────────────────────

enum PageKind {
  STATIC
  COLLECTION
  DETAIL
  DATA
}

model Page {
  id                 String            @id @default(cuid())
  key                String?           @unique @db.VarChar(80) // stable key: "home", "news-listing"
  kind               PageKind          @default(STATIC)
  contentType        String?           @db.VarChar(60) // registry key; required for COLLECTION/DETAIL
  dataProvider       String?           @db.VarChar(60) // registry key; required for DATA
  status             ContentStatus     @default(DRAFT)
  isActive           Boolean           @default(true) // instant hide, status untouched (ADR-015 #4 pattern)
  visibility         FeatureVisibility @default(PUBLIC)
  requiresFeature    String?           @db.VarChar(80)
  // Plain ids, not Prisma relations: the pointed-at PageVersion is created
  // after the Page row exists (avoids a circular required FK), and the
  // published/draft distinction is app-level, not referential (ADR-021 §5).
  publishedVersionId String?           @unique
  draftVersionId     String?           @unique
  // Nested paths (ADR-032 §6): breadcrumbs + per-locale path derivation.
  parentId           String?
  group              String?           @db.VarChar(80) // admin-only list-screen label
  createdById        String
  updatedById        String?
  publishedAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  parent       Page?             @relation("PageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Page[]            @relation("PageTree")
  translations PageTranslation[]
  versions     PageVersion[]     @relation("PageVersions")

  @@index([kind, status])
  @@index([parentId])
  @@map("pages")
}

model PageTranslation {
  id               String            @id @default(cuid())
  pageId           String
  locale           String            @db.VarChar(10)
  title            String            @db.VarChar(255)
  slug             String            @db.VarChar(255) // localized; empty for the home page
  path             String            @db.VarChar(500) // resolved public path, no locale prefix stored
  status           TranslationStatus @default(DRAFT)
  seoTitle         String?           @db.VarChar(70)
  seoDescription   String?           @db.VarChar(180)
  ogImageId        String? // MediaAsset id (ADR-017) — plain id, no relation
  canonicalUrl     String?           @db.VarChar(500)
  robots           String?           @default("index,follow") @db.VarChar(40)
  includeInSitemap Boolean           @default(true)
  schemaType       String?           @default("WebPage") @db.VarChar(40)
  sourceHash       String?           @db.VarChar(64) // OUTDATED flow, as content translations do
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
  @@unique([locale, path])
  @@index([locale, slug])
  @@map("page_translations")
}

model PageVersion {
  id          String   @id @default(cuid())
  pageId      String
  // 0 on the mutable draft row (never shown as publish history); 1, 2, 3…
  // on immutable published snapshots (ADR-032 §6: publish creates a new
  // row, the draft is never renumbered).
  number      Int
  layout      Json // the block tree — Zod-validated on every read and write
  note        String?  @db.VarChar(500)
  authorId    String
  // Optimistic lock on the draft row only: autosave refuses a stale
  // `revision`. Publish snapshots copy the draft's current revision as-is.
  revision    Int      @default(0)
  gateResult  Json? // last publish-gate run (ADR-024 §4); gate wiring lands Phase 3/8
  templateKey String?  @db.VarChar(80) // which LayoutTemplate this started from (ADR-033), usage reporting
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  page Page @relation("PageVersions", fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, number])
  @@map("page_versions")
}

// ADR-033 §1/§2 — "Linked": a node stores an id; editing this row updates
// every placement. Config is the same StyleChoices + MotionChoices shape
// node.style.overrides uses (ADR-032 §2, ADR-024 §2) — validated by
// @repo/contracts on write, not by the database. `scope` narrows which
// block types a preset is offered for in the composer ("any" | a block
// type key | "widget"); it is advisory, not a foreign key.
model StylePreset {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  scope       String   @default("any") @db.VarChar(60)
  config      Json
  isSystem    Boolean  @default(false) // seeded; clone-only (ADR-016/ADR-023 pattern)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("style_presets")
}

// ADR-023 — referenced by id from `collection`/`featured-content` blocks'
// `cardTemplateId` prop, never copied: editing one updates every
// placement. `contentType: null` means it works against any
// `CollectionItem`. Deletion is refused while any `ContentReference`
// still points at it (styles.ts's own pattern, `refType: "CARD_TEMPLATE"`
// — that enum value has existed since Phase 1/2's schema, ADR-033 §4).
model CardTemplate {
  id             String   @id @default(cuid())
  key            String   @unique @db.VarChar(80)
  name           String   @db.VarChar(120)
  contentType    String?  @db.VarChar(60)
  variant        String   @db.VarChar(60)
  config         Json
  isSystem       Boolean  @default(false)
  previewImageId String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("card_templates")
}

// ADR-033 §1/§3 — "Start from": layout is copied into the target and is
// then independent (no id retained, no propagation). One table covers
// page/section/block/part templates — a table per preset "type" would be
// identical rows under different names (ADR-033 Alternatives).
enum LayoutTemplateKind {
  PAGE
  SECTION
  BLOCK
  PART
}

model LayoutTemplate {
  id             String             @id @default(cuid())
  key            String             @unique @db.VarChar(80)
  name           String             @db.VarChar(120)
  kind           LayoutTemplateKind
  pageKind       PageKind? // PAGE templates: which Page.kind they seed
  partKey        String?            @db.VarChar(60) // PART templates: header | footer | announcement | … (ADR-027 presets)
  layout         Json // a full tree (PAGE/PART), a subtree (SECTION), or one node (BLOCK) — Zod-validated
  previewImageId String?
  isSystem       Boolean            @default(false)
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@map("layout_templates")
}

// ADR-033 §4 — one usage/integrity index over every layout-holding row.
// Written on save by syncReferences() as a diff-and-replace; the compound
// unique is what makes "replace" well-defined (no duplicate reference rows
// for one source/target/field triple).
enum ReferenceSourceType {
  PAGE_VERSION
  MENU_ITEM
  CARD_TEMPLATE
  STYLE_PRESET
  LAYOUT_TEMPLATE
  ARTICLE
  COURSE
  BRAND
  SETTING
  // ADR-068 §7 — a video topic holds media placements (cover, uploaded
  // videos, posters), so it is a reference SOURCE like an article or a course.
  VIDEO_TOPIC
  // ADR-132 — a quiz's cover is a media placement like a course's.
  QUIZ
  // ADR-133 — a glossary topic's cover, the same placement.
  GLOSSARY_TOPIC
  // ADR-167 — a promotion's image.
  PROMOTION
}

enum ReferenceType {
  MEDIA
  CARD_TEMPLATE
  STYLE_PRESET
  WIDGET
  PART
  PAGE
  ARTICLE
  ARTICLE_CATEGORY
  ARTICLE_TAG
  COURSE
  GLOSSARY_TERM
}

model ContentReference {
  id         String              @id @default(cuid())
  sourceType ReferenceSourceType
  sourceId   String
  refType    ReferenceType
  refId      String
  field      String?             @db.VarChar(120) // "style.presetId", "props.image", "props.link"
  createdAt  DateTime            @default(now())

  @@unique([sourceType, sourceId, refType, refId, field])
  @@index([refType, refId])
  @@map("content_references")
}

// ─── Email platform (Module 17, ADR-078) ──────────────────────────────────

enum EmailDriver {
  SMTP
  SENDGRID // v3 Web API; the key lives in `passwordCipher` (ADR-152)
  LOG // unconfigured / dev: the send is logged, never transmitted
}

enum SmtpSecurity {
  NONE
  STARTTLS
  TLS
}

enum EmailBodyMode {
  RICH // the body is composed into the shared layout
  HTML // a full document, exactly as the designer wrote it
}

enum EmailDeliveryStatus {
  SENT
  FAILED
  SUPPRESSED // a switch was off; nothing reached a transport
}

/// Singleton, id = "default". ADR-078 #3: `passwordCipher` is the ONE
/// sanctioned database secret — AES-256-GCM under EMAIL_SECRET_KEY (env),
/// write-only in the UI, and selected by loadTransportDriver() alone.
/// ADR-078 #4: editing this row is super_admin-only, because the HOST is an
/// escalation path — repointing delivery captures the next reset link.
model EmailTransport {
  id             String       @id @default("default")
  driver         EmailDriver  @default(LOG)
  host           String?      @db.VarChar(255)
  port           Int?
  security       SmtpSecurity @default(STARTTLS)
  username       String?      @db.VarChar(255)
  passwordCipher String?      @db.Text
  /// ADR-152: SendGrid validates every send and delivers none. Read only by
  /// the SENDGRID driver — SMTP has no equivalent, so the switch is absent there.
  sandboxMode    Boolean      @default(false)
  lastVerifiedAt DateTime?
  lastError      String?      @db.Text
  updatedBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("email_transport")
}

/// Google reCAPTCHA v3 on sign-in, sign-up and the support form (ADR-156). A
/// singleton like EmailTransport: Settings → General → reCAPTCHA edits it.
/// `secretKeyCipher` is AES-256-GCM under CAPTCHA_SECRET_KEY, write-only in
/// the UI, and `loadCaptchaRuntime()` (@repo/auth) is its ONE reader.
model CaptchaConfig {
  id              String      @id @default("default")
  enabled         Boolean     @default(false)
  /// Google's site key. Public by design: Google puts it in the page.
  siteKey         String?     @db.VarChar(100)
  secretKeyCipher String?     @db.Text
  /// SCORE = v3, invisible; CHECKBOX = v2 "I'm not a robot" in the form
  /// (ADR-158). Each needs its own kind of key from Google.
  mode            CaptchaMode @default(SCORE)
  /// The v3 score a request must reach, 0.1-0.9. Google suggests 0.5.
  /// Ignored in CHECKBOX mode: a v2 answer has no score.
  minScore        Float       @default(0.5)
  /// When a browser token last passed with the saved keys: the check that
  /// has to succeed before `enabled` may be switched on.
  lastVerifiedAt  DateTime?
  updatedBy       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("captcha_config")
}

/// Which Google reCAPTCHA a CaptchaConfig row runs (ADR-158).
enum CaptchaMode {
  SCORE
  CHECKBOX
}

/// The row is the CONTENT of a template whose KEY is declared in code
/// (EMAIL_TEMPLATES, @repo/contracts). An admin cannot mint a key, because
/// code decides when an email is sent — ADR-078 #5, the ADR-042 split.
model EmailTemplate {
  key       String   @id @db.VarChar(60)
  isActive  Boolean  @default(true)
  fromName  String?  @db.VarChar(120)
  fromEmail String?  @db.VarChar(255)
  replyTo   String?  @db.VarChar(255)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations EmailTemplateTranslation[]

  @@map("email_templates")
}

model EmailTemplateTranslation {
  id                String            @id @default(cuid())
  templateKey       String            @db.VarChar(60)
  locale            String            @db.VarChar(10)
  subject           String            @db.VarChar(200)
  preheader         String?           @db.VarChar(200)
  mode              EmailBodyMode     @default(RICH)
  bodyHtml          String            @db.MediumText
  translationStatus TranslationStatus @default(DRAFT)
  sourceHash        String?           @db.VarChar(64)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  template EmailTemplate @relation(fields: [templateKey], references: [key], onDelete: Cascade)

  @@unique([templateKey, locale])
  @@map("email_template_translations")
}

/// ADR-078 #10 — the attempt, never the message. No body and no variables:
/// a reset link sitting in a table an admin can read is a second
/// interception path. Purged after 90 days by /api/cron/housekeeping.
model EmailDelivery {
  id                String              @id @default(cuid())
  templateKey       String              @db.VarChar(60)
  to                String              @db.VarChar(255)
  locale            String              @db.VarChar(10)
  subject           String              @db.VarChar(200)
  status            EmailDeliveryStatus
  reason            String?             @db.VarChar(500)
  providerMessageId String?             @db.VarChar(255)
  isTest            Boolean             @default(false)
  triggeredBy       String?
  /// ADR-171: the announcement this send belongs to. No FK — the log outlives
  /// nothing it points at, and it filters by this column only.
  campaignId        String?             @db.VarChar(191)
  createdAt         DateTime            @default(now())

  @@index([createdAt])
  @@index([campaignId])
  @@index([templateKey, createdAt])
  @@index([status, createdAt])
  @@map("email_deliveries")
}

// ─── Newsletter (Module 17, ADR-080, changes-21 F7) ──────────────

enum SubscriberStatus {
  PENDING // signed up, has not clicked confirm yet — purged after 7 days
  ACTIVE
  UNSUBSCRIBED
}

/// Double opt-in newsletter consent (ADR-080).
///
/// **Both tokens are stored HASHED** (SHA-256, hex) and never in plaintext:
/// the row is readable by any admin with `newsletter.view`, and a plaintext
/// unsubscribe token in that table is a way to unsubscribe anyone from the
/// admin screen. The confirm token expires in 48h and is single-use; the
/// unsubscribe token is long-lived on purpose, because it has to keep working
/// in a message sent months ago (RFC 8058 one-click).
///
/// ADR-080 #6: `userId` is filled at CONFIRM time when the address matches a
/// live user, and the relation is `SetNull`. The consent was given
/// independently of the account, so a hard erase of the user must not delete
/// it — today's user deletion is soft (`deletedAt`), which leaves the link
/// intact and is correct.
model NewsletterSubscriber {
  id     String           @id @default(cuid())
  /// Lower-cased on write, so `@@unique` actually means one consent per address.
  email  String           @db.VarChar(255)
  locale String           @db.VarChar(10)
  status SubscriberStatus @default(PENDING)
  /// Where the address came from: a placement (footer | home | news | analysis),
  /// the sign-up checkbox (signup) or an administrator (admin) — ADR-124.
  source String           @db.VarChar(32)

  confirmTokenHash     String?   @db.VarChar(64)
  confirmExpiresAt     DateTime?
  unsubscribeTokenHash String    @db.VarChar(64)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  confirmedAt       DateTime?
  unsubscribedAt    DateTime?
  /// Who stopped the mail: "subscriber" (their own link) or "admin" (the list
  /// screen). Null on rows unsubscribed before ADR-124, read as "subscriber" —
  /// only an ADMIN's unsubscribe may be undone by an admin without a fresh
  /// confirmation, because only that one was not the reader withdrawing consent.
  unsubscribedVia   String?   @db.VarChar(16)
  /// Throttles the "resend the confirmation" path without a second Redis key.
  lastConfirmSentAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([email])
  @@unique([confirmTokenHash])
  @@unique([unsubscribeTokenHash])
  @@index([status, createdAt])
  @@index([userId])
  @@map("newsletter_subscribers")
}

// ─── Market data platform (Module 13, ADR-087) ───────────────
//
// Module 13's original spec said market data never goes into Prisma as a
// source of truth. That is right about TICKS and wrong about history: a
// correlation window is history by definition, and re-fetching 250 bars per
// instrument per page view is not a cache strategy, it is a rate-limit
// incident. Live rates still live in the Redis-shaped cache; what is stored
// here is the daily series worth keeping.

enum MarketDriver {
  /// AlphaVantage FX_DAILY / DIGITAL_CURRENCY_DAILY.
  ALPHAVANTAGE
  /// No provider at all. Bars are whatever has been loaded; every rate-backed
  /// surface degrades to a labelled empty state. Exists so the whole platform
  /// is testable and demonstrable with no key (ADR-087 #11).
  MANUAL
}

enum MarketInstrumentKind {
  CURRENCY
  PAIR
  CRYPTO
  METAL
  INDEX
  COMMODITY
}

/// The provider, as one row (`id = "default"`).
///
/// ADR-087 #5: `apiKeyCipher` is security.md #10's SECOND and last exception.
/// It is AES-256-GCM-sealed under `MARKET_SECRET_KEY`, which stays in the
/// environment; it is write-only in the admin UI; `loadProviderDriver()` is
/// its only reader; and `MarketProviderView` has no key property at all — not
/// omitted, ABSENT, so there is no shape through which it can be serialised
/// into an RSC payload by accident.
///
/// Gated on `market.providers.manage` rather than super_admin, unlike
/// ADR-078's SMTP transport: a read-only quote key captures nothing, and
/// nothing is delivered TO a user through this host.
model MarketProvider {
  id     String       @id @default("default")
  driver MarketDriver @default(MANUAL)

  baseUrl      String? @db.VarChar(255)
  apiKeyCipher String? @db.Text

  /// Live-rate cache TTL, seconds. The snapshot's `cacheLife` mirrors it.
  refreshSeconds Int @default(300)
  /// How long a stale copy stays servable when the provider is down. A stale
  /// rate is LABELLED, never hidden (ADR-087 #11).
  staleSeconds   Int @default(86400)

  isEnabled Boolean @default(false)

  lastSyncAt    DateTime?
  lastSyncError String?   @db.Text

  updatedAt DateTime @updatedAt

  @@map("market_providers")
}

/// One tradable thing. ONE table with a `kind`, not two (ADR-087 #1) — a
/// second `MarketCurrency` would need its own admin screen to say the same
/// thing. `kind` decides who reads it: `CURRENCY` for the converter, `PAIR`
/// for the pip and position calculators, the rest for correlation and the
/// risk meter.
model MarketInstrument {
  id   String               @id @default(cuid())
  kind MarketInstrumentKind

  /// "EUR/USD", "EUR", "XAU/USD" — our symbol, not the provider's.
  symbol      String @db.VarChar(20)
  displayName String @db.VarChar(80)

  /// Required for PAIR, meaningless otherwise; the contract refines that.
  base  String? @db.VarChar(10)
  quote String? @db.VarChar(10)

  /// What the driver calls it, when that differs from `symbol`.
  providerSymbol String? @db.VarChar(40)

  /// Null means derive from the quote currency (0.01 for JPY, else 0.0001).
  pipSize  Decimal? @db.Decimal(18, 10)
  decimals Int      @default(5)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bars MarketDailyBar[]

  @@unique([symbol])
  @@index([kind, isActive, sortOrder])
  @@map("market_instruments")
}

/// One day, for one instrument.
///
/// **Bars, not closes** (ADR-087 #2). A high cannot be derived from closing
/// prices — the period's true high almost never lands on a close, so a range
/// assembled out of closes understates the real one and every pivot level
/// computed from that range is wrong by the same amount. The provider returns
/// all four in one response, so storing four columns costs no extra request.
///
/// Nothing but the pivot calculator reads `open`/`high`/`low`. Correlation,
/// the risk meter and the rate snapshot read `close` and only `close`.
///
/// **`Decimal`, not `Float`** (ADR-087 #3): a close is money-shaped and gets
/// subtracted from its neighbour to make a return.
model MarketDailyBar {
  id           String   @id @default(cuid())
  instrumentId String
  date         DateTime @db.Date

  open  Decimal @db.Decimal(24, 10)
  high  Decimal @db.Decimal(24, 10)
  low   Decimal @db.Decimal(24, 10)
  close Decimal @db.Decimal(24, 10)

  createdAt DateTime @default(now())

  instrument MarketInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, date])
  @@index([instrumentId, date(sort: Desc)])
  @@map("market_daily_bars")
}

// ─── Tools (Module 13, ADR-086) ──────────────────────────────
//
// ADR-086 #1: the SET of tools is code (`TOOL_KEYS` in `@repo/contracts`) and
// everything a tool SAYS is data. One table, not eight (#2) — eight tables for
// eight tools would make adding the ninth a migration, and the fields they
// would not share are exactly the ones `config` already types.

/// One of `TOOL_KEYS`. There is deliberately **no `status`, no
/// `scheduledFor` and no seven-state machine** (ADR-086 #8): a tool is a
/// fixture of the site, not an article — it is on or off. ADR-071 gave
/// `scheduledFor` to the five entities a reader browses as a feed, where
/// "publish this on Tuesday" is a real editorial act; scheduling a calculator
/// solves nothing and would add a fourth switch to a surface that already has
/// three (the feature flag, `isEnabled`, and the translation's own status).
model Tool {
  id  String @id @default(cuid())
  /// A `TOOL_KEYS` member. Code owns the set; a row for an unknown key is
  /// ignored by every reader rather than rendering an unroutable page.
  key String @unique @db.VarChar(40)

  isEnabled Boolean @default(true)
  sortOrder Int     @default(0)

  /// A `MediaAsset` id, deliberately without an FK (ADR-035). Generated art
  /// is the fallback when it is null.
  coverAssetId String?

  /// Validated against `TOOL_CONFIG_SCHEMAS[key]` — one schema, checked by
  /// the admin form, the server action and the service alike.
  config Json

  relatedCount Int     @default(6)
  showRelated  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations ToolTranslation[]

  @@index([isEnabled, sortOrder])
  @@map("tools")
}

model ToolTranslation {
  id     String @id @default(cuid())
  toolId String
  locale String @db.VarChar(10)

  title      String  @db.VarChar(160)
  tagline    String? @db.VarChar(220)
  /// Sanitized server-side on save (security.md #8).
  intro      String? @db.Text
  /// The explainer band. Sanitized on save.
  body       String? @db.LongText
  /// `[{ question, answer }]` — the shape articles already use.
  faq        Json?
  /// `[{ icon, title, text }]` — the "why use this" band (ADR-114 #3). PLAIN
  /// text, not rich: three lines under a glyph need no markup, and `icon` is a
  /// `TOOL_HIGHLIGHT_ICONS` member rather than a free-text lucide name.
  /// Null or empty means the band does not render.
  highlights Json?

  seoTitle        String? @db.VarChar(70)
  seoDescription  String? @db.VarChar(180)
  seoFocusKeyword String? @db.VarChar(100)

  translationStatus TranslationStatus @default(DRAFT)
  /// Covers ALL prose, `faq` question AND answer included (ADR-069's rule):
  /// an FAQ-only edit must flip sibling translations OUTDATED exactly as a
  /// body edit does.
  sourceHash        String?           @db.VarChar(64)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([toolId, locale])
  @@map("tool_translations")
}

// ═══════════════════════════════════════════════════════════════
// Module 18 — the AI platform (ADR-097/098/099/100, changes-29 A1)
// ═══════════════════════════════════════════════════════════════
//
// Six tables and two enums. The shapes copy `MarketProvider` and
// `EmailDelivery` deliberately: a sealed key with one reader, a log that holds
// no bodies, and a rollup that outlives the rows it was built from.

enum AiProviderKind {
  ANTHROPIC
  OPENAI
  /// ADR-120: five vendors and one custom gateway that speak the OpenAI Chat
  /// Completions shape. The KIND names who is billed and what the usage screen
  /// says; the protocol is `AI_PROVIDER_PRESETS` in @repo/contracts, so a new
  /// vendor is a registry row and a migration, never a driver.
  GOOGLE
  XAI
  DEEPSEEK
  MISTRAL
  OPENROUTER
  OPENAI_COMPATIBLE
  /// No provider at all: a deterministic local driver that returns a labelled
  /// placeholder and records a zero-cost usage row. ADR-087 #11's MANUAL,
  /// applied here — it is what makes the platform demonstrable, seedable and
  /// testable with no key, and what an instance with no AI_SECRET_KEY falls
  /// back to instead of throwing.
  ECHO
}

enum AiCallStatus {
  OK
  FAILED
  /// Client went away mid-stream. Tokens observed so far are still recorded:
  /// the provider bills them, so a row that pretends otherwise under-reports
  /// spend.
  ABORTED
  /// Refused by us before the provider was called — budget cap, global
  /// switch, feature switch, or the per-user rate window. Zero cost, and
  /// deliberately a ROW: "why did nothing happen" is the question the usage
  /// screen has to answer.
  REFUSED
}

/// One configured provider. A SET, not a singleton — unlike MarketProvider
/// and EmailTransport — because the owner asked for several, and because
/// "which provider does this feature use" is a per-feature answer.
model AiProvider {
  id   String         @id @default(cuid())
  kind AiProviderKind

  label   String  @db.VarChar(80)
  /// Overrides the SDK default. Normalised at the point of USE, not on save
  /// (the trailing-slash lesson, DEVLOG 2026-09-14).
  baseUrl String? @db.VarChar(255)

  /// ADR-098: AES-256-GCM under AI_SECRET_KEY. Write-only in the UI;
  /// loadProviderDriver() is the ONE reader; AiProviderView has no key
  /// property at all.
  apiKeyCipher String? @db.Text

  isEnabled Boolean @default(false)
  /// Exactly one row may be true. Enforced in the service inside a
  /// transaction, not by a constraint: MySQL/MariaDB has no partial unique
  /// index, and a nullable-unique trick would encode "default" as "not null",
  /// which is a second meaning for a column that already has one.
  isDefault Boolean @default(false)

  lastTestAt    DateTime?
  lastTestError String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models   AiModel[]
  features AiFeature[]

  @@index([isEnabled])
  @@map("ai_providers")
}

/// A model the admin may select, and the price it is billed at (ADR-100 #2).
model AiModel {
  id         String @id @default(cuid())
  providerId String
  /// The provider's own id, e.g. "claude-opus-5". Never parsed, never
  /// pattern-matched — a model id is an opaque string and every attempt to
  /// derive meaning from its shape ages badly.
  modelId    String @db.VarChar(80)
  label      String @db.VarChar(80)

  /// USD per 1M tokens. Decimal, not Float: ADR-087 #3's rule — a number a
  /// human reconciles against an invoice does not live in binary floating
  /// point.
  inputPricePerMTok       Decimal  @db.Decimal(12, 6)
  outputPricePerMTok      Decimal  @db.Decimal(12, 6)
  /// Cache reads are ~0.1x input and cache writes ~1.25x; null means "price
  /// them as input", which is the honest answer for a provider that does not
  /// report them separately.
  cachedInputPricePerMTok Decimal? @db.Decimal(12, 6)

  /// The provider's own output ceiling. The effective ceiling is the MINIMUM
  /// of this, the feature's, and the admin's ai.maxTokensPerRequest.
  maxOutputTokens Int     @default(4096)
  supportsVision  Boolean @default(false)
  supportsStream  Boolean @default(true)

  isEnabled Boolean  @default(true)
  /// "Prices as of" — shown beside every spend figure (ADR-100 #2).
  pricedAt  DateTime @default(now())
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider AiProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  features AiFeature[]

  @@unique([providerId, modelId])
  @@index([isEnabled, sortOrder])
  @@map("ai_models")
}

/// One AI_FEATURES key. The row holds policy; the registry holds behaviour
/// (ADR-097 #3). A row for an unknown key is ignored by every reader, the way
/// an unknown Tool key is (ADR-086 #1).
model AiFeature {
  key String @id @db.VarChar(40)

  isEnabled Boolean @default(false)

  /// Null = use the default provider / that provider's default model.
  providerId String?
  modelId    String?

  /// Null = the feature's registry ceiling.
  maxOutputTokens Int?

  /// Appended to the system prompt, escaped, hard-capped at 1000 chars, and
  /// validated by the same schema the form and the action use. It is for
  /// house style ("British spelling, never use the word delve"), NOT for
  /// replacing the instruction: an admin who can rewrite the whole prompt is
  /// an admin who can turn the summariser into a general chatbot billed to
  /// the company, which is behaviour, and behaviour is code (ADR-042).
  extraInstructions String? @db.VarChar(1000)

  updatedAt DateTime @updatedAt

  provider AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  model    AiModel?    @relation(fields: [modelId], references: [id], onDelete: SetNull)

  @@map("ai_features")
}

/// One call. Holds NO prompt and NO completion (ADR-097 #7). Purged at 90 days
/// by the housekeeping sweep; the rollups survive it.
model AiUsage {
  id String @id @default(cuid())

  feature  String         @db.VarChar(40)
  provider AiProviderKind
  /// Denormalised strings, not FKs: this row must still read correctly after
  /// a provider or model row is deleted. EmailDelivery makes the same call
  /// for the same reason.
  modelId  String         @db.VarChar(80)

  status AiCallStatus
  /// Machine-readable taxonomy — "rate_limited", "provider_timeout",
  /// "budget_exceeded", "provider_error", … Never a raw provider message,
  /// which can quote the prompt back.
  reason String?      @db.VarChar(80)

  inputTokens       Int @default(0)
  outputTokens      Int @default(0)
  cachedInputTokens Int @default(0)

  /// Frozen at write time (ADR-100 #3).
  costUsd    Decimal @default(0) @db.Decimal(12, 6)
  durationMs Int     @default(0)

  /// The admin who triggered it. SetNull: a deleted staff account must not
  /// delete the spend record it caused.
  userId     String?
  /// What it was about — "article" / "media" / "lesson" + the id. Optional
  /// because "draft me an intro" is about nothing yet.
  entityType String? @db.VarChar(40)
  entityId   String? @db.VarChar(40)

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([feature, createdAt])
  @@index([userId, createdAt])
  @@map("ai_usage")
}

/// The dashboard's source, and the reason retention does not erase spend
/// history (ADR-097 #7). Written in the same transaction as the AiUsage row.
model AiUsageDaily {
  id   String   @id @default(cuid())
  /// UTC day. Every window in this platform is UTC, including the budget
  /// month — a spend cap that moves with a viewer's timezone is two caps.
  date DateTime @db.Date

  feature  String         @db.VarChar(40)
  provider AiProviderKind
  modelId  String         @db.VarChar(80)

  calls             Int @default(0)
  failures          Int @default(0)
  inputTokens       Int @default(0)
  outputTokens      Int @default(0)
  cachedInputTokens Int @default(0)

  costUsd Decimal @default(0) @db.Decimal(14, 6)

  @@unique([date, feature, provider, modelId])
  @@index([date])
  @@map("ai_usage_daily")
}

/// The budget month: one row, read on EVERY call before the provider is
/// touched, so the check is a single indexed row read rather than a sum.
model AiBudgetPeriod {
  /// "YYYY-MM", UTC.
  period String @id @db.VarChar(7)

  costUsd Decimal @default(0) @db.Decimal(14, 6)
  calls   Int     @default(0)

  /// The cap in force when the period started — copied, not read live, so
  /// raising the cap mid-month is an explicit act (it rewrites this column
  /// through the settings screen) rather than a silent retroactive one.
  budgetUsd Decimal @default(0) @db.Decimal(14, 6)

  warnedAt     DateTime?
  capReachedAt DateTime?
  /// Dedupe for the admin notice: notified once per period, not once per
  /// blocked call. Without it a capped platform sends a notification storm.
  notifiedAt   DateTime?

  updatedAt DateTime @updatedAt

  @@map("ai_budget_periods")
}

// ─── Automatic translation (ADR-160) ───────────────────────────
//
// Google Cloud Translation Basic (v2), owned by `@repo/translate`. A domain
// package owning its own tables, beside `@repo/ai` and never inside it: this
// vendor is a fixed endpoint billed per CHARACTER, with no model to choose,
// which is why none of it fits `AiProvider` / `AiUsage`.

/// The one translation provider. A singleton like CaptchaConfig
/// (`id = "default"`), edited at Settings → Translation.
///
/// `apiKeyCipher` is security.md #10's FIFTH exception: AES-256-GCM under
/// TRANSLATE_SECRET_KEY, write-only in the UI, and `loadTranslateDriver()`
/// (@repo/translate) is its ONE reader. There is deliberately no base URL
/// column: the endpoint is fixed in code, so a changed setting cannot send the
/// site's content to another host (ADR-160 #5).
model TranslateProvider {
  id           String                @id @default("default")
  /// Off until a connection test has passed with the key being saved.
  enabled      Boolean               @default(false)
  /// Which service translates (ADR-186). The sealed key belongs to it: a
  /// change of provider needs a new key in the same save.
  kind         TranslateProviderKind @default(GOOGLE)
  apiKeyCipher String?               @db.Text

  /// USD per 1M characters, admin-editable, copied into each usage row at
  /// write time (ADR-100 #3). Decimal for the reason AiModel's prices are.
  pricePerMillionChars Decimal @default(20) @db.Decimal(12, 6)
  /// Characters per UTC calendar month. Null = no cap. At the cap work
  /// PAUSES; nothing fails (ADR-160 #6).
  monthlyCharBudget    Int?

  /// The last "Test connection": when, and its taxonomy result ("ok",
  /// "auth_failed", …). Never the provider's own message.
  lastTestedAt   DateTime?
  lastTestResult String?   @db.VarChar(40)

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("translate_provider")
}

/// One row per request to Google (a batch of segments), or per refusal made
/// before a request. Holds no text: a count, never the content.
model TranslateUsage {
  id       String                 @id @default(cuid())
  status   TranslateCallStatus
  /// Machine-readable taxonomy (`TRANSLATE_REASONS`), never a raw provider
  /// message.
  reason   String?                @db.VarChar(40)
  /// Which service was called (ADR-186 #6). Null for a refusal made before
  /// any provider was loaded.
  provider TranslateProviderKind?

  sourceLocale String          @db.VarChar(10)
  targetLocale String          @db.VarChar(10)
  format       TranslateFormat
  segments     Int             @default(0)
  /// What was SENT, markup included: the conservative estimate. Every cost
  /// figure on screen says "estimated" (ADR-100).
  characters   Int             @default(0)

  /// Frozen at write time (ADR-100 #3).
  costUsd    Decimal @default(0) @db.Decimal(12, 6)
  durationMs Int     @default(0)

  /// Who triggered it; null for the job runner. A plain id rather than a
  /// relation, as AiUsage's model id is: this row must outlive the account.
  userId     String? @db.VarChar(191)
  entityType String? @db.VarChar(40)
  entityId   String? @db.VarChar(40)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
  @@map("translate_usage")
}

/// The budget month: read before every request, so the check is one indexed
/// row rather than a sum (AiBudgetPeriod's reasoning). Incremented with a
/// single INSERT … ON DUPLICATE KEY UPDATE, which is atomic where Prisma's
/// upsert is not.
model TranslateUsagePeriod {
  /// "YYYY-MM", UTC.
  period     String   @id @db.VarChar(7)
  characters BigInt   @default(0)
  costUsd    Decimal  @default(0) @db.Decimal(14, 6)
  requests   Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("translate_usage_periods")
}

/// The automatic translation service (ADR-186).
enum TranslateProviderKind {
  /// Google Cloud Translation Basic (v2), ADR-160.
  GOOGLE
  /// DeepL API (v2), free or Pro by the key.
  DEEPL
}

enum TranslateCallStatus {
  OK
  FAILED
  /// Refused by us before Google was called: not configured, switched off,
  /// or the monthly budget. Zero characters billed.
  REFUSED
}

enum TranslateFormat {
  TEXT
  HTML
}

/// Automatic translation work (ADR-162), owned by `@repo/translate`. One row
/// per entity × locale (ITEM), or per locale being backfilled
/// (BACKFILL_LOCALE, whose entityType and entityId are "*" — never NULL,
/// because MariaDB treats every NULL as distinct in a unique index).
///
/// A job carries NO content: it reads the English source when it runs, so a
/// later edit is never translated from a stale copy (ADR-162 #5).
model TranslationJob {
  id         String               @id @default(cuid())
  kind       TranslationJobKind
  entityType String               @db.VarChar(40)
  /// 191, the width every String id in this schema may have.
  entityId   String               @db.VarChar(191)
  locale     String               @db.VarChar(10)
  status     TranslationJobStatus @default(PENDING)
  attempts   Int                  @default(0)
  /// Backoff and pauses: not eligible before this time (ADR-162 #6).
  runAfter   DateTime             @default(now())
  /// Set by the atomic claim; the runner reads its rows back by it (#3).
  claimToken String?              @db.VarChar(40)
  claimedAt  DateTime?
  /// Set by an enqueue that found this job RUNNING: the source changed while
  /// it worked. Finishing then re-queues instead of marking DONE, because the
  /// job may already have read the old source (ADR-162 #2 as amended).
  rerun      Boolean              @default(false)
  /// A BACKFILL_LOCALE job's progress: where the next page starts (#9).
  cursor     String?              @db.VarChar(200)
  /// `TRANSLATE_REASONS` taxonomy only, never a provider message.
  lastError  String?              @db.VarChar(40)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([kind, entityType, entityId, locale])
  @@index([status, runAfter])
  @@index([claimToken])
  @@index([locale, status])
  @@map("translation_jobs")
}

enum TranslationJobKind {
  ITEM
  BACKFILL_LOCALE
}

enum TranslationJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// ─────────────────────────────────────────────────────────────
// PROMOTIONS (ADR-167, changes-52)
// A time-boxed webinar, event, offer, news item or announcement, shown as a
// popup on the pages its `placements` name and, optionally, in the home band.
// The record is DATA; the slots it appears in are code (ADR-042).
// ─────────────────────────────────────────────────────────────

enum PromotionKind {
  WEBINAR
  EVENT
  OFFER
  NEWS
  ANNOUNCEMENT
}

/// Only what a person decides. Scheduled / Live / Ended are DERIVED from the
/// display window when read (ADR-167 #2), so no cron ever changes this.
enum PromotionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PromotionFrequency {
  ONCE
  PER_SESSION
  DAILY
  EVERY_VISIT
}

enum PromotionAudience {
  ALL
  GUESTS
  LEARNERS
}

/// Exactly one destination (ADR-167 #4), enforced in @repo/contracts — the
/// same reason `VideoTopicVideo` gives for not using a CHECK constraint.
enum PromotionLinkKind {
  CONTENT
  PATH
  EXTERNAL
  NONE
}

enum PromotionTargetType {
  COURSE
  LESSON
  QUIZ
  ARTICLE
  VIDEO_TOPIC
  GLOSSARY_TERM
  TOOL
}

/// What a reader in a locale with no usable translation sees (ADR-167 #6).
enum PromotionUntranslated {
  HIDE
  SHOW_DEFAULT
}

/// Where a promotion's banner sits (ADR-173). LEFT/RIGHT render at the inline
/// start/end, so they mirror on a right-to-left page.
enum PromotionBarPosition {
  TOP
  BOTTOM
  LEFT
  RIGHT
}

model Promotion {
  id     String          @id @default(cuid())
  kind   PromotionKind
  status PromotionStatus @default(DRAFT)

  /// string[] of `PROMOTION_PLACEMENTS` keys (@repo/contracts), validated on
  /// write. JSON rather than a join table: the set is a small code registry.
  placements  Json
  showAsPopup Boolean              @default(true)
  showInBand  Boolean              @default(false)
  /// A small dismissible banner (ADR-173), at `barPosition`.
  showAsBar   Boolean              @default(false)
  barPosition PromotionBarPosition @default(BOTTOM)
  priority    Int                  @default(0)

  /// The display window. `startsAt` inclusive, `endsAt` exclusive.
  startsAt      DateTime
  endsAt        DateTime
  /// A webinar's or event's own time — announced before it happens, so it is
  /// not the display window.
  eventStartsAt DateTime?
  eventEndsAt   DateTime?

  frequency    PromotionFrequency    @default(PER_SESSION)
  delaySeconds Int                   @default(5)
  audience     PromotionAudience     @default(ALL)
  untranslated PromotionUntranslated @default(HIDE)

  // MediaAsset id as a plain String (ADR-035) — no FK, so deleting an asset
  // cannot cascade into content. `ContentReference` is the integrity index.
  imageAssetId String?

  linkKind   PromotionLinkKind    @default(NONE)
  /// CONTENT only. Polymorphic, so no FK: the target is resolved at read time
  /// by its own module's public rule, and a target that is not public hides
  /// the promotion (ADR-167 #4).
  targetType PromotionTargetType?
  targetId   String?              @db.VarChar(64)
  /// PATH only — site-relative, no locale prefix (`internalPathSchema`).
  targetPath String?              @db.VarChar(500)
  /// EXTERNAL only — https (`externalUrlSchema`).
  targetUrl  String?              @db.VarChar(500)

  /// A webinar's recording, shown after `eventEndsAt` while it is public.
  recordingTopicId String? @db.VarChar(64)

  /// Bumped on every save. The popup's "already seen" key includes it, so an
  /// edited promotion is shown again.
  version     Int       @default(1)
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  translations PromotionTranslation[]
  dailyStats   PromotionDailyStat[]

  @@index([status, startsAt, endsAt])
  @@index([deletedAt])
  @@map("promotions")
}

model PromotionTranslation {
  id          String @id @default(cuid())
  promotionId String
  locale      String @db.VarChar(10)

  /// Optional: a promotion linked to site content borrows the target's title
  /// when this is empty. A standalone one must fill it (contracts).
  title    String? @db.VarChar(160)
  body     String? @db.Text // short rich text, sanitized on save (security.md #8)
  badge    String? @db.VarChar(40)
  ctaLabel String? @db.VarChar(60)
  imageAlt String? @db.VarChar(250)

  translationStatus TranslationStatus @default(TRANSLATED)
  sourceHash        String?           @db.VarChar(64)
  translatedBy      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, locale])
  @@index([translationStatus])
  @@map("promotion_translations")
}

/// Where a counted promotion was seen (ADR-170).
enum PromotionSurface {
  POPUP
  BAND
  BAR
}

/// A promotion's approximate reach for one UTC day on one surface (ADR-170).
/// Counts only: no IP, cookie, user, session, user agent or path is stored,
/// so there is no event log and nothing here identifies a person. Written by
/// one `INSERT … ON DUPLICATE KEY UPDATE`, never by a Prisma upsert.
model PromotionDailyStat {
  promotionId String
  day         DateTime         @db.Date
  surface     PromotionSurface
  impressions Int              @default(0)
  clicks      Int              @default(0)
  dismissals  Int              @default(0)
  updatedAt   DateTime         @updatedAt

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@id([promotionId, day, surface])
  @@map("promotion_daily_stats")
}

// ─────────────────────────────────────────────────────────────
// ANNOUNCEMENTS (ADR-171, changes-54)
// One email about one piece of content, sent once to a deduplicated set of
// recipients through a database job queue (ADR-162's pattern). A recipient
// row is the job: it holds no rendered body — the runner renders from the
// template at send time (ADR-078 #10's reasoning, kept).
// ─────────────────────────────────────────────────────────────

/// What an announcement is about. Phase 2 adds VIDEO_TOPIC, ARTICLE and
/// GLOSSARY_TERM, each with its own template (changes-54 §14).
enum AnnouncementKind {
  COURSE
  /// ADR-172: a free-form email to chosen audiences; its body is the campaign's.
  CUSTOM
  /// ADR-172: a free-form email to exactly one person.
  DIRECT
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

enum AnnouncementRecipientStatus {
  PENDING
  /// Claimed by a runner. A lease older than ten minutes becomes FAILED
  /// `lease_expired`, never PENDING: at-most-once (ADR-171 #3).
  SENDING
  SENT
  FAILED
  /// Unsubscribed between the snapshot and the send.
  SUPPRESSED
  /// The campaign was cancelled before this row was claimed.
  SKIPPED
}

enum EmailSuppressionScope {
  ANNOUNCEMENTS
}

enum EmailSuppressionReason {
  UNSUBSCRIBED
  ADMIN
  BOUNCE
  COMPLAINT
}

model EmailCampaign {
  id             String             @id @default(cuid())
  kind           AnnouncementKind
  /// The Course.id (for COURSE). No FK: kinds point at different tables.
  /// Null for CUSTOM and DIRECT, which are about no piece of content (ADR-172).
  targetId       String?            @db.VarChar(191)
  /// Admin-facing label, e.g. "Forex Basics — launch".
  name           String             @db.VarChar(160)
  /// Null means the template's own subject, per language.
  subject        String?            @db.VarChar(200)
  /// Optional plain-text note, escaped like any variable.
  message        String?            @db.VarChar(500)
  /// `{ keys: string[], courseIds?: string[], userIds?: string[] }`,
  /// validated by `announcementAudienceSchema`.
  audience       Json
  status         AnnouncementStatus @default(DRAFT)
  scheduledFor   DateTime?
  /// ADR-171 #7: the target is SCHEDULED; start the first tick it is public.
  sendWhenLive   Boolean            @default(false)
  snapshotAt     DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  /// Why a campaign was CANCELLED by the system (`target_unavailable`).
  cancelReason   String?            @db.VarChar(40)
  /// Aggregates survive the 90-day recipient purge.
  recipientCount Int                @default(0)
  sentCount      Int                @default(0)
  failedCount    Int                @default(0)
  skippedCount   Int                @default(0)
  createdById    String
  sentById       String?
  cancelledById  String?
  /// ADR-172 #3: the design this email was started from. Provenance only —
  /// the design was COPIED, and editing it later changes nothing here.
  designId       String?            @db.VarChar(191)
  /// DIRECT: `Reply-To` is the author's own address instead of the sender's.
  replyToSelf    Boolean            @default(false)
  /// ADR-172 #2: a CUSTOM send needs a test since the last edit. The hash is
  /// of the content at that test; any edit changes the current one.
  lastTestedAt   DateTime?
  testedHash     String?            @db.VarChar(64)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  recipients EmailCampaignRecipient[]
  contents   EmailCampaignContent[]

  @@index([status, scheduledFor])
  @@index([kind, targetId])
  @@index([createdAt])
  @@map("email_campaigns")
}

model EmailCampaignRecipient {
  id           String                      @id @default(cuid())
  campaignId   String
  /// Normalised (trimmed, lower-cased): the dedupe key (ADR-171 #2).
  email        String                      @db.VarChar(255)
  userId       String?
  subscriberId String?
  name         String?                     @db.VarChar(255)
  locale       String                      @db.VarChar(10)
  status       AnnouncementRecipientStatus @default(PENDING)
  attempts     Int                         @default(0)
  runAfter     DateTime                    @default(now())
  claimToken   String?                     @db.VarChar(40)
  claimedAt    DateTime?
  /// A taxonomy code, never a provider message (ADR-162 #1).
  lastError    String?                     @db.VarChar(40)
  /// The EmailDelivery row, for the log link.
  deliveryId   String?
  sentAt       DateTime?

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@index([status, runAfter])
  @@index([claimToken])
  @@index([campaignId, status])
  /// A person's email history on their record (ADR-172).
  @@index([userId])
  @@map("email_campaign_recipients")
}

/// ADR-172 #2 — the words of a CUSTOM or DIRECT campaign, one row per locale.
/// Sanitised on save; frozen once the campaign leaves DRAFT. Kept with the
/// campaign (it is the record of what was sent, and holds no address).
model EmailCampaignContent {
  id         String        @id @default(cuid())
  campaignId String
  locale     String        @db.VarChar(10)
  subject    String        @db.VarChar(200)
  preheader  String?       @db.VarChar(200)
  mode       EmailBodyMode @default(RICH)
  bodyHtml   String        @db.MediumText
  updatedAt  DateTime      @updatedAt

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, locale])
  @@map("email_campaign_contents")
}

/// ADR-172 #3 — a reusable starting point for a custom email, built on the
/// Templates screen. NOT a template: it has no key and code never sends it
/// (ADR-078 #5 stands). Starting an email from it copies it.
model EmailDesign {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(120)
  description String?       @db.VarChar(300)
  mode        EmailBodyMode @default(RICH)
  subject     String?       @db.VarChar(200)
  preheader   String?       @db.VarChar(200)
  bodyHtml    String        @db.MediumText
  archivedAt  DateTime?
  createdById String
  updatedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([archivedAt, updatedAt])
  @@map("email_designs")
}

/// ADR-171 #5 — someone said no. Keyed by ADDRESS, so it covers a learner and
/// a subscriber-only contact the same way. Never purged: deleting a row would
/// re-enrol the person who asked to stop.
model EmailSuppression {
  id          String                 @id @default(cuid())
  email       String                 @db.VarChar(255)
  scope       EmailSuppressionScope
  reason      EmailSuppressionReason
  /// Null when the person did it themselves.
  createdById String?
  createdAt   DateTime               @default(now())

  @@unique([email, scope])
  @@map("email_suppressions")
}
