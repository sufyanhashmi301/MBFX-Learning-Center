# Copy to .env and fill in. Real values are never committed.
# Secrets live here (env), never in the database, never in NEXT_PUBLIC_*.

DATABASE_URL="mysql://user:pass@localhost:3306/mbfx_learning_center"
REDIS_URL="redis://localhost:6379"

# Better Auth (packages/auth, Module 04)
BETTER_AUTH_SECRET=""              # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"

# OAuth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""


# One app, two surfaces (ADR-006): admin is a path on the same origin.
#
# These two are NEXT_PUBLIC_, so their values are INLINED INTO THE BUNDLE when
# `next build` runs. An image built once and deployed to a real domain keeps
# whatever the build machine had — which is how a production container mails
# `http://localhost:3000` logos and reset links. Set the two below for the
# browser, and set SITE_URL / ADMIN_URL on the SERVER at deploy time: they are
# read at call time, they win, and changing them needs no rebuild. Everything
# that prints an absolute url server-side (emails, sitemap, robots, RSS, share
# cards) resolves through `siteOrigin()` in @repo/utils, which reads them.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3000/keystone"
SITE_URL=""
ADMIN_URL=""

# Media storage (Module 11, ADR-017). Local-disk driver root (default
# <cwd>/storage/uploads); S3 values select the S3 driver when it lands.
UPLOADS_DIR=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_HOST=""
# Optional video compression (ADR-144 §4). The absolute path to the server's
# own ffmpeg binary. When set, an uploaded video is re-encoded to H.264/AAC MP4
# (+faststart, CRF 28, long edge capped at 1920) and kept only if smaller; any
# failure stores the original. Blank = no compression, uploads stored as sent.
FFMPEG_PATH=""

# Seed only. Omit in production and force a reset on first login instead.
SEED_ADMIN_EMAIL="admin@mbxpro.com"
SEED_ADMIN_PASSWORD=""

# `pnpm seed:live` only (ADR-144 §1) — read ONCE, at seed time, and sealed into
# the database through the same services the admin screens use (security.md
# #10). Each block is optional: unset means that provider is simply not
# configured, never an error. A provider that already holds a key is left
# alone. Remove these from the environment after the seed has run.
SEED_MARKET_PROVIDER_KIND=""        # ALPHAVANTAGE | MANUAL (default: the exported defaults)
SEED_MARKET_PROVIDER_API_KEY=""
SEED_AI_PROVIDER_KIND=""            # ANTHROPIC | OPENAI | GOOGLE | … (default: the exported defaults)
SEED_AI_PROVIDER_API_KEY=""
SEED_AI_PROVIDER_BASE_URL=""        # only for kinds that need one
SEED_AI_MODEL_LIGHT=""              # model ids; default: the exported ai.model.* tiers
SEED_AI_MODEL_STANDARD=""
SEED_AI_MODEL_HEAVY=""
SEED_SMTP_HOST=""
SEED_SMTP_PORT=""                   # default 587
SEED_SMTP_SECURITY=""               # NONE | STARTTLS | TLS (default: TLS on 465, else STARTTLS)
SEED_SMTP_USER=""
SEED_SMTP_PASSWORD=""
SEED_SMTP_FROM=""                   # written to the email.fromEmail setting

# Market data (Module 13). There is NO API key here: since ADR-087 the
# provider, its base URL and its key live in the `MarketProvider` row and are
# edited at /admin/market/provider, with the key sealed under
# MARKET_SECRET_KEY below. `MARKET_DATA_PROVIDER`/`ALPHAVANTAGE_API_KEY` were
# the pre-ADR-087 path and are read by nothing.

# Which About-section dataset renders (ADR-051 §1). "demo" — the default —
# shows the PLACEHOLDER figures, history, awards, locations and channels in
# apps/web/app/(public)/[locale]/about/_content/about-facts.demo.ts. Every one
# of those values is invented.
#
# Set to "real" before production: it swaps in REAL_ABOUT_FACTS, and ADR-047
# §2's empty rule hides every section the owner has not filled in yet.
ABOUT_CONTENT_MODE=demo

# The cron routes (ADR-071, ADR-078 #9, ADR-096). ONE bearer token for all
# three, called by whatever scheduler the deployment has:
#   POST /api/cron/market-sync   — daily bars (see docs/ops/cron.md)
#   POST /api/cron/publish-due   — scheduled content bookkeeping
#   POST /api/cron/housekeeping  — email + newsletter retention
# Unset means every one of them answers 503 and refuses to run. Nothing breaks:
# scheduled content still goes live (visibility is decided in the query) and
# every rate-backed surface degrades to its last good value and says so.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Email (Module 17, ADR-078). The key that seals the SMTP password stored in
# the database — security.md #10's ONE exception, and the key itself still
# lives here, never in a row. 32 bytes, base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it, saved credentials cannot be read and delivery falls back to the
# log driver rather than failing sign-up.
EMAIL_SECRET_KEY=

# Announcement emails (ADR-171). Signs the one-click unsubscribe link in every
# announcement — an HMAC key, not a seal, so it is NOT a security.md #10
# exception. 32 random bytes, base64url. Without it, announcements refuse to
# send (every one must carry a working unsubscribe). To rotate, move the old
# value to EMAIL_LINK_SECRET_PREVIOUS so links in mail already sent keep
# working, and set a new EMAIL_LINK_SECRET.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EMAIL_LINK_SECRET=
EMAIL_LINK_SECRET_PREVIOUS=

# Market data (Module 13, ADR-087). The key that seals the market provider's
# API key stored in the database — security.md #10's SECOND exception. Same
# shape as EMAIL_SECRET_KEY: 32 bytes, base64, env-only.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it, a stored provider key cannot be opened; the platform falls back
# to the MANUAL driver, and every rate-backed tool says so rather than failing.
MARKET_SECRET_KEY=

# AI platform (Module 18, ADR-098). The key that seals the AI provider's API
# key stored in the database — security.md #10's THIRD exception, and the last
# without an ADR that says why none of the three existing seals will do. Same
# shape again: 32 bytes, base64, env-only.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it, a stored provider key cannot be opened. The providers screen says
# so on the screen that can fix it, and the platform falls back to the ECHO
# driver rather than throwing — but note that an ABSENT key reads exactly like
# a REJECTED one unless you look, which is why the screen names this variable.
# An edited .env does nothing until `next dev` restarts.
AI_SECRET_KEY=

# Google reCAPTCHA v3 (ADR-156). The keys are entered in Settings → General →
# reCAPTCHA, not here. This is the key that SEALS Google's secret key before
# it is stored: security.md #10's FOURTH exception. Same shape: 32 bytes,
# base64. Without it the tab cannot save a secret, so reCAPTCHA cannot be
# switched on. Losing or changing it switches reCAPTCHA OFF (never "refuse
# everyone") until the secret is entered again.
CAPTCHA_SECRET_KEY=
# Break-glass: any value but 0/false switches reCAPTCHA off whatever the tab
# says. For a Google outage, or keys that lock everyone out. Restart to apply.
CAPTCHA_DISABLED=

# Automatic translation: Google Cloud Translation (ADR-160) or DeepL
# (ADR-186). The API key is entered in Settings → Translation → Provider, not
# here. This is the key that SEALS it before it is stored:
# security.md #10's FIFTH exception. Same shape: 32 bytes, base64. Without it
# the screen cannot save a key, so automatic translation cannot be switched
# on. Losing or changing it PAUSES automatic translation (never "fail every
# job") until the key is entered again.
TRANSLATE_SECRET_KEY=

# Nightly market sweep (ADR-087). POST /api/cron/market-sync reuses
# CRON_SECRET above. Unset means the endpoint refuses every request; no page
# breaks, the stored bars simply stop advancing and every surface says "as of".

# Cloudflare cache purge (scripts/deploy.sh, after the restart). Optional —
# both unset and the step is skipped, which is the right setting for an
# install that is not behind Cloudflare. The token needs exactly one
# permission, Zone · Cache Purge · Purge, scoped to this zone; the zone id is
# in the right-hand column of the domain's Overview page. Without it, a hashed
# chunk that 404s during the build window (`next build` rewrites .next/static
# in place) stays 404 at the edge long after the file is back, because Next
# answers a missing static file with the prerendered not-found page and its
# cache headers — the whole site then renders unstyled.
CF_API_TOKEN=
CF_ZONE_ID=
